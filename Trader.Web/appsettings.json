{
  "Summary": {
    "GenerateHour": 8,
    "OllamaUrl": "http://localhost:11434",
    "OllamaModel": ""
  },
  "Backup": {
    "Directory": "backups",
    "IntervalHours": 24,
    "KeepCount": 14
  },
  "ConnectionStrings": {
    "Trader": "Data Source=trader.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sources": {
    "Rss": {
      "SymbolFeedTemplate": "https://feeds.finance.yahoo.com/rss/2.0/headline?s={symbol}&region=US&lang=en-US",
      "SymbolFeedName": "Yahoo Finance",
      "IntervalMinutes": 10,
      "Feeds": [
        { "Name": "CNBC", "Url": "https://www.cnbc.com/id/100003114/device/rss/rss.html" },
        { "Name": "MarketWatch", "Url": "https://feeds.content.dowjones.io/public/rss/mw_topstories" },
        { "Name": "Investing.com", "Url": "https://www.investing.com/rss/news.rss" },
        { "Name": "Seeking Alpha", "Url": "https://seekingalpha.com/market_currents.xml" },
        { "Name": "Financial Times", "Url": "https://www.ft.com/rss/home" },
        { "Name": "CoinDesk", "Url": "https://www.coindesk.com/arc/outboundfeeds/rss/" },
        { "Name": "Cointelegraph", "Url": "https://cointelegraph.com/rss" },
        { "Name": "Decrypt", "Url": "https://decrypt.co/feed" },
        { "Name": "Google News", "Url": "https://news.google.com/rss/search?q=stock+market+OR+forex+OR+commodities+when:1d&hl=en-US&gl=US&ceid=US:en" },
        { "Name": "Bloomberg", "Url": "https://feeds.bloomberg.com/markets/news.rss" },
        { "Name": "WSJ Markets", "Url": "https://feeds.a.dj.com/rss/RSSMarketsMain.xml" },
        { "Name": "BBC Business", "Url": "https://feeds.bbci.co.uk/news/business/rss.xml" },
        { "Name": "The Guardian Business", "Url": "https://www.theguardian.com/business/rss" },
        { "Name": "Seeking Alpha Articles", "Url": "https://seekingalpha.com/feed.xml", "SourceType": "Social" },
        { "Name": "TradingView Ideas", "Url": "https://www.tradingview.com/feed/", "SourceType": "Social" },
        { "Name": "Calculated Risk", "Url": "https://www.calculatedriskblog.com/feeds/posts/default", "SourceType": "Social" },
        { "Name": "Wolf Street", "Url": "https://wolfstreet.com/feed/", "SourceType": "Social" },
        { "Name": "Naked Capitalism", "Url": "https://www.nakedcapitalism.com/feed", "SourceType": "Social" },
        { "Name": "Federal Reserve", "Url": "https://www.federalreserve.gov/feeds/press_all.xml", "SourceType": "Macro" },
        { "Name": "ECB", "Url": "https://www.ecb.europa.eu/rss/press.html", "SourceType": "Macro" }
      ]
    },
    "Gdelt": {
      "Enabled": true,
      "IntervalMinutes": 30,
      "Queries": [ "stock market", "federal reserve", "oil prices", "gold price" ]
    },
    "StockTwits": {
      "Enabled": true,
      "IntervalMinutes": 10
    },
    "Finnhub": {
      "ApiKey": ""
    },
    "Reddit": {
      "ClientId": "",
      "ClientSecret": "",
      "Subreddits": [ "wallstreetbets", "stocks", "investing", "StockMarket", "options", "SecurityAnalysis", "ValueInvesting", "Daytrading", "Forex", "Economics", "CryptoCurrency", "dividends" ]
    },
    "Edgar": {
      "ContactEmail": ""
    },
    "Marketaux": {
      "ApiKey": ""
    },
    "Fred": {
      "ApiKey": ""
    },
    "HackerNews": {
      "Enabled": true
    },
    "Mastodon": {
      "Enabled": true,
      "Instance": "https://mastodon.social",
      "Hashtags": [ "stocks", "investing", "finance", "trading", "economy", "markets", "forex", "stockmarket", "daytrading" ]
    },
    "Lemmy": {
      "Enabled": true,
      "Communities": [ "stocks@lemmy.world", "investing@lemmy.world", "economics@lemmy.world", "economy@lemmy.world", "wallstreetbets@lemmy.world", "bitcoin@lemmy.world", "economics@lemmy.ml" ]
    },
    "ApeWisdom": {
      "Enabled": true,
      "MinMentions": 30,
      "SpikeFactor": 2
    }
  }
}
