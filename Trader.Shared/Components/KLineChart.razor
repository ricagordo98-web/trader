@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container" class="kline-container"></div>

@code {
    private readonly string _id = Guid.NewGuid().ToString("N");
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<KLineChart>? _self;
    private IReadOnlyList<Candle>? _appliedCandles;
    private IReadOnlyList<ChartLevel>? _appliedLevels;
    private bool _appliedDark;
    private bool _drawingsApplied;
    private bool _created;

    [Parameter, EditorRequired] public string Symbol { get; set; } = string.Empty;
    [Parameter] public int PricePrecision { get; set; } = 2;
    [Parameter] public string Interval { get; set; } = "1d";
    [Parameter] public IReadOnlyList<Candle> Candles { get; set; } = [];
    [Parameter] public bool Dark { get; set; } = true;
    [Parameter] public bool ShowVolume { get; set; } = true;
    [Parameter] public IReadOnlyList<ChartLevel> Levels { get; set; } = [];
    [Parameter] public string DrawingsJson { get; set; } = "[]";
    [Parameter] public EventCallback<string> DrawingsChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Trader.Shared/js/klinechartInterop.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _id, _container, _self, Dark, ShowVolume);
            _appliedDark = Dark;
            _created = true;
        }

        if (!_created || _module is null)
        {
            return;
        }

        if (_appliedDark != Dark)
        {
            _appliedDark = Dark;
            await _module.InvokeVoidAsync("setTheme", _id, Dark);
        }

        if (!ReferenceEquals(_appliedCandles, Candles))
        {
            _appliedCandles = Candles;
            await _module.InvokeVoidAsync("setData", _id, Symbol, PricePrecision, Interval, Candles);
        }

        if (!ReferenceEquals(_appliedLevels, Levels) && Candles.Count > 0)
        {
            _appliedLevels = Levels;
            await _module.InvokeVoidAsync("setLevels", _id, Levels);
        }

        if (!_drawingsApplied && Candles.Count > 0)
        {
            _drawingsApplied = true;
            using JsonDocument document = JsonDocument.Parse(DrawingsJson);
            await _module.InvokeVoidAsync("loadDrawings", _id, document.RootElement);
        }
    }

    public async Task<IReadOnlyList<string>> ToggleIndicatorAsync(string name, bool mainPane) =>
        _module is null ? [] : await _module.InvokeAsync<string[]>("toggleIndicator", _id, name, mainPane);

    public async Task StartDrawingAsync(string name)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("startDrawing", _id, name);
        }
    }

    public async Task RemoveSelectedAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("removeSelected", _id);
        }
    }

    public async Task ClearDrawingsAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("clearDrawings", _id);
        }
    }

    public async Task SetCompareAsync(string label, IReadOnlyList<Candle> candles)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setCompare", _id, label, candles);
        }
    }

    public async Task ClearCompareAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("clearCompare", _id);
        }
    }

    public async Task PushBarAsync(Candle candle)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("pushBar", _id, candle);
        }
    }

    [JSInvokable]
    public Task OnDrawingsChanged(string json) => DrawingsChanged.InvokeAsync(json);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
