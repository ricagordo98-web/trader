@using System.Globalization
@implements IDisposable
@inject TraderApiClient Api

<MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle1" Class="mb-1">Backtest intradiário</MudText>
    <MudText Typo="Typo.body2" Class="symbol-name mb-3">
        Repete as regras das sugestões intraday (<GlossaryTerm Key="vwap">VWAP</GlossaryTerm>, abertura, volume, momentum, dia anterior e gap) sobre as últimas semanas de velas de 5 minutos, com <GlossaryTerm Key="slippage">slippage</GlossaryTerm> e custos.
        Mede se os sinais teriam dado margem antes de arriscares dinheiro. Não inclui notícias (não há histórico) e não garante o futuro.
    </MudText>

    <div class="d-flex flex-wrap gap-3 align-center">
        <MudNumericField T="int" @bind-Value="_request.Days" Label="Dias" Min="3" Max="25" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px" Disabled="_running" />
        <MudNumericField T="int" @bind-Value="_request.MaxSymbols" Label="Ativos" Min="1" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px" Disabled="_running" />
        <MudSelect T="AssetClass?" @bind-Value="_request.AssetClass" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px" Disabled="_running" Clearable="true">
            <MudSelectItem T="AssetClass?" Value="AssetClass.Stock">Ações</MudSelectItem>
            <MudSelectItem T="AssetClass?" Value="AssetClass.Etf">ETFs</MudSelectItem>
            <MudSelectItem T="AssetClass?" Value="AssetClass.Commodity">Mercadorias</MudSelectItem>
            <MudSelectItem T="AssetClass?" Value="AssetClass.Forex">Forex</MudSelectItem>
            <MudSelectItem T="AssetClass?" Value="AssetClass.Crypto">Cripto</MudSelectItem>
            <MudSelectItem T="AssetClass?" Value="AssetClass.Index">Índices</MudSelectItem>
        </MudSelect>
        <MudNumericField T="double" @bind-Value="_request.SlippagePercent" Label="Slippage por lado (%)" Min="0" Max="1" Step="0.01" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px" Disabled="_running" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_running" OnClick="RunAsync" StartIcon="@Icons.Material.Filled.PlayArrow">
            @(_running ? "A simular…" : "Executar backtest intradiário")
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="symbol-name d-block mt-2">Os custos por tipo de ativo são os do backtest diário. O Yahoo só guarda cerca de um mês de velas de 5 minutos.</MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>

@if (_running)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.body2" Class="mb-2">A descarregar as velas e a simular sessão a sessão. Pode demorar até um minuto.</MudText>
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else if (_result is null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudText Color="Color.Secondary">Ainda não correste nenhum backtest intradiário.</MudText>
    </MudPaper>
}
else
{
    IntradayBacktestResult r = _result;

    <MudAlert Severity="@VerdictSeverity(r.Verdict.Code)" Variant="Variant.Outlined" Class="mb-4">
        <MudText Typo="Typo.subtitle1">@r.Verdict.Title</MudText>
        <MudText Typo="Typo.body2">@r.Verdict.Detail</MudText>
    </MudAlert>

    <MudText Typo="Typo.caption" Class="symbol-name mb-3">
        @r.SymbolsTested ativos · @r.SessionsTested sessões · @r.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) a @r.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        · gerado em @r.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
    </MudText>

    <MudGrid Spacing="3" Class="mb-4">
        @foreach ((string label, string value, Color color) in Kpis(r))
        {
            <MudItem xs="6" md="4" lg="2">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.caption" Class="symbol-name">@label</MudText>
                    <MudText Typo="Typo.h6" Color="color">@value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="mb-4">
        <MudTable Items="Comparison(r)" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" T="BacktestGroup">
            <HeaderContent>
                <MudTh>Comparação</MudTh>
                <MudTh Style="text-align:right">Operações</MudTh>
                <MudTh Style="text-align:right">Acerto</MudTh>
                <MudTh Style="text-align:right">R médio líq.</MudTh>
                <MudTh Style="text-align:right">IC 95%</MudTh>
                <MudTh Style="text-align:right">Profit factor</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd Style="text-align:right">@context.Stats.Trades</MudTd>
                <MudTd Style="text-align:right">@((context.Stats.WinRate * 100).ToString("0", CultureInfo.InvariantCulture))%</MudTd>
                <MudTd Style="text-align:right">@Signed(context.Stats.AverageNetR)</MudTd>
                <MudTd Style="text-align:right">@Signed(context.Stats.ConfidenceLow) a @Signed(context.Stats.ConfidenceHigh)</MudTd>
                <MudTd Style="text-align:right">@(context.Stats.ProfitFactor?.ToString("0.00", CultureInfo.InvariantCulture) ?? "—")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Por hora de entrada</MudText>
                @foreach (BacktestGroup group in r.ByHour)
                {
                    <div class="d-flex py-1">
                        <MudText Typo="Typo.body2">@group.Name</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name ml-2">@group.Stats.Trades</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="@(group.Stats.AverageNetR >= 0 ? Color.Success : Color.Error)">@Signed(group.Stats.AverageNetR) R</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Por tipo de ativo</MudText>
                @foreach (BacktestGroup group in r.ByAssetClass)
                {
                    <div class="d-flex py-1">
                        <MudText Typo="Typo.body2">@group.Name</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name ml-2">@group.Stats.Trades</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="@(group.Stats.AverageNetR >= 0 ? Color.Success : Color.Error)">@Signed(group.Stats.AverageNetR) R</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Por sinal presente</MudText>
                @foreach (BacktestGroup group in r.BySignal)
                {
                    <div class="d-flex py-1">
                        <MudText Typo="Typo.body2"><GlossaryTerm Key="@Glossary.KeyForSignal(group.Name)">@group.Name</GlossaryTerm></MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name ml-2">@group.Stats.Trades</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="@(group.Stats.AverageNetR >= 0 ? Color.Success : Color.Error)">@Signed(group.Stats.AverageNetR) R</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (r.Curve.Count > 1)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">R acumulado (líquido)</MudText>
            <CumulativeCurve Points="@r.Curve.Select(c => c.CumulativeR).ToList()" />
        </MudPaper>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Notas</MudText>
        @foreach (string note in r.Notes)
        {
            <MudText Typo="Typo.caption" Class="symbol-name d-block">• @note</MudText>
        }
    </MudPaper>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly IntradayBacktestRequest _request = new();
    private IntradayBacktestResult? _result;
    private string? _error;
    private bool _running;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _result = await Api.GetLastIntradayBacktestAsync(_cts.Token);

            if ((await Api.GetProfileAsync(_cts.Token)).Costs is { } mine)
            {
                _request.Costs = mine;
            }
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível obter o último backtest.";
        }
    }

    private async Task RunAsync()
    {
        _running = true;
        _error = null;

        try
        {
            (IntradayBacktestResult? result, string? error) = await Api.RunIntradayBacktestAsync(_request, _cts.Token);

            if (result is not null)
            {
                _result = result;
            }

            _error = error;
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível executar o backtest. Verifica se o servidor está a correr.";
        }
        finally
        {
            _running = false;
        }
    }

    private static IEnumerable<(string Label, string Value, Color Color)> Kpis(IntradayBacktestResult r)
    {
        yield return ("Operações", r.Strategy.Trades.ToString(CultureInfo.InvariantCulture), Color.Default);
        yield return ("Taxa de acerto", $"{r.Strategy.WinRate * 100:0}%", r.Strategy.WinRate >= 0.5 ? Color.Success : Color.Warning);
        yield return ("R médio líq.", Signed(r.Strategy.AverageNetR), r.Strategy.AverageNetR >= 0 ? Color.Success : Color.Error);
        yield return ("R total líq.", r.Strategy.TotalNetR.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture), r.Strategy.TotalNetR >= 0 ? Color.Success : Color.Error);
        yield return ("Drawdown máx.", $"{r.Strategy.MaxDrawdownR:0.0} R", Color.Default);
        yield return ("Duração média", $"{r.AverageMinutesHeld:0} min", Color.Default);
    }

    private static IEnumerable<BacktestGroup> Comparison(IntradayBacktestResult r)
    {
        yield return new BacktestGroup("Estratégia", r.Strategy);
        yield return new BacktestGroup("Direção contrária (mesmas entradas)", r.Mirrored);
        yield return new BacktestGroup("1.ª metade do período", r.FirstHalf);
        yield return new BacktestGroup("2.ª metade do período", r.SecondHalf);
    }

    private static string Signed(double value) => value.ToString("+0.000;-0.000;0.000", CultureInfo.InvariantCulture);

    private static Severity VerdictSeverity(string code) => code switch
    {
        "promising" => Severity.Success,
        "no-edge" => Severity.Error,
        "insufficient" => Severity.Info,
        _ => Severity.Warning
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
