<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_value" Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="@MaxLength" AutoFocus="true" Immediate="true" OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(_value)">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _value = string.Empty;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string ConfirmText { get; set; } = "Guardar";

    [Parameter] public string Initial { get; set; } = string.Empty;

    [Parameter] public int MaxLength { get; set; } = 40;

    protected override void OnInitialized() => _value = Initial;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_value))
        {
            Submit();
        }
    }

    private void Submit() => Dialog.Close(DialogResult.Ok(_value.Trim()));

    private void Cancel() => Dialog.Cancel();
}
