@using Microsoft.AspNetCore.SignalR.Client
@using Trader.Core.Abstractions
@implements IAsyncDisposable
@inject TraderApiClient Api
@inject AuthSession Session
@inject ThemeState Theme
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClientStore Store

<MudDialog ContentClass="chart-dialog-content">
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <MudText Typo="Typo.h6">@Quote.Symbol</MudText>
            <MudText Typo="Typo.body2" Class="symbol-name">@Quote.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="chart-dialog">
            <div class="chart-toolbar">
                @foreach (Timeframe timeframe in Timeframes)
                {
                    <MudButton Size="Size.Small" Variant="@(timeframe == _timeframe ? Variant.Filled : Variant.Text)" Color="@(timeframe == _timeframe ? Color.Primary : Color.Default)"
                               OnClick="@(() => SelectTimeframeAsync(timeframe))">@timeframe.Label</MudButton>
                }
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                <MudMenu Label="Indicadores" StartIcon="@Icons.Material.Filled.Insights" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @foreach (IndicatorOption indicator in Indicators)
                    {
                        <MudMenuItem OnClick="@(() => ToggleIndicatorAsync(indicator))">@(_activeIndicators.Contains(indicator.Name) ? "✓ " : "    ")@indicator.Label</MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem OnClick="ConfigureIndicatorAsync">Configurar parâmetros e cores…</MudMenuItem>
                </MudMenu>
                <MudMenu Label="Comparar" StartIcon="@Icons.Material.Filled.CompareArrows" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @if (_compareSymbol is not null)
                    {
                        <MudMenuItem OnClick="ClearCompareAsync">✕ Remover @_compareSymbol</MudMenuItem>
                        <MudDivider />
                    }
                    @foreach (InstrumentQuote option in _compareOptions)
                    {
                        <MudMenuItem OnClick="@(() => SelectCompareAsync(option))">@(option.Symbol == _compareSymbol ? "✓ " : "    ")@option.Symbol · @option.Name</MudMenuItem>
                    }
                </MudMenu>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.QuestionAnswer" OnClick="OpenWhyAsync">Porquê?</MudButton>
                @if (Quote.AssetClass == AssetClass.Crypto)
                {
                    <MudButton Size="Size.Small" Variant="@(_showFlow ? Variant.Filled : Variant.Text)" Color="@(_showFlow ? Color.Primary : Color.Default)" StartIcon="@Icons.Material.Filled.SwapVert" OnClick="@(() => _showFlow = !_showFlow)">Fluxo</MudButton>
                }
                <MudMenu Label="Visual" StartIcon="@Icons.Material.Filled.Tune" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @foreach (VisualOption option in Kinds)
                    {
                        <MudMenuItem OnClick="@(() => SetKindAsync(option))">@(_kind == option.Key ? "✓ " : "    ")@option.Label</MudMenuItem>
                    }
                    <MudDivider />
                    @foreach (VisualOption option in Axes)
                    {
                        <MudMenuItem OnClick="@(() => SetAxisAsync(option))">@(_axis == option.Key ? "✓ " : "    ")@option.Label</MudMenuItem>
                    }
                </MudMenu>
                <MudMenu Label="Níveis" StartIcon="@Icons.Material.Filled.HorizontalSplit" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @foreach ((string group, string label) in LevelGroups)
                    {
                        <MudMenuItem OnClick="@(() => ToggleLevelGroupAsync(group))">@(_levelGroups.Contains(group) ? "✓ " : "    ")@label</MudMenuItem>
                    }
                </MudMenu>
                <MudMenu Label="Eventos" StartIcon="@Icons.Material.Filled.Flag" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @foreach ((string kind, string label) in EventKinds)
                    {
                        <MudMenuItem OnClick="@(() => ToggleEventKindAsync(kind))">@(_eventKinds.Contains(kind) ? "✓ " : "    ")@label</MudMenuItem>
                    }
                </MudMenu>
                <MudButton Size="Size.Small" Variant="@(_plan is not null ? Variant.Filled : Variant.Text)" Color="@(_plan is not null ? Color.Primary : Color.Default)" StartIcon="@Icons.Material.Filled.Straighten" OnClick="TogglePlanAsync">Plano</MudButton>
                <MudButton Size="Size.Small" Variant="@(_alertLinePrice is not null ? Variant.Filled : Variant.Text)" Color="@(_alertLinePrice is not null ? Color.Warning : Color.Default)" StartIcon="@Icons.Material.Filled.AddAlert" OnClick="ToggleAlertLineAsync">Alerta</MudButton>
                <MudButton Size="Size.Small" Variant="@(_replaying ? Variant.Filled : Variant.Text)" Color="@(_replaying ? Color.Primary : Color.Default)" StartIcon="@Icons.Material.Filled.History" OnClick="ToggleReplayAsync" Disabled="@(!CanReplay && !_replaying)">Replay</MudButton>
                <MudMenu Label="Modelos" StartIcon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    <MudMenuItem OnClick="SaveTemplateAsync">Guardar indicadores atuais…</MudMenuItem>
                    @if (_templates.Count > 0)
                    {
                        <MudDivider />
                        @foreach (ChartTemplate template in _templates)
                        {
                            <MudMenuItem OnClick="@(() => ApplyTemplateAsync(template))">@template.Name</MudMenuItem>
                        }
                        <MudDivider />
                        @foreach (ChartTemplate template in _templates)
                        {
                            <MudMenuItem OnClick="@(() => DeleteTemplateAsync(template))">✕ Apagar «@template.Name»</MudMenuItem>
                        }
                    }
                </MudMenu>
                @foreach (ChartLevel level in _levels)
                {
                    <span class="chart-legend"><span class="chart-legend-dot" style="background:@level.Color"></span>@level.Label @level.Price.ToString(PricePrecision > 3 ? "F5" : "F2", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</span>
                }
                @if (_ready)
                {
                    <MudTooltip Text="@SourceTooltip">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(_liveProblem is null ? Color.Success : Color.Warning)" Class="ma-0">
                            @(_liveProblem ?? LiveLabel)
                        </MudChip>
                    </MudTooltip>
                }
                <MudSpacer />
                <MudTooltip Text="Apagar selecionado (Del)">
                    <MudIconButton Icon="@Icons.Material.Filled.Backspace" Size="Size.Small" aria-label="Apagar desenho selecionado" OnClick="RemoveSelectedAsync" />
                </MudTooltip>
                <MudTooltip Text="Apagar todos os desenhos">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" aria-label="Apagar todos os desenhos" OnClick="ClearDrawingsAsync" />
                </MudTooltip>
            </div>
            @if (_plan is { } plan)
            {
                PositionResult? result = PlanResult;
                <div class="chart-strip">
                    <MudText Typo="Typo.caption">Plano (arrasta as linhas azul, vermelha e verde):</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">entrada @plan.Entry.ToString("0.#####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Class="ma-0">SL @plan.Stop.ToString("0.#####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Class="ma-0">TP @plan.Target.ToString("0.#####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</MudChip>
                    @if (result is { IsValid: true })
                    {
                        <MudText Typo="Typo.caption">@(result.Direction == TradeDirection.Buy ? "Compra" : "Venda") · R:R @(result.RiskReward?.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")) ?? "—") · risco @result.RiskAmount.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")) @_account.Currency · @result.Units.ToString("0.####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT")) un</MudText>
                    }
                    else if (result is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@string.Join(" ", result.Errors)</MudText>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="FlipPlanAsync">Inverter</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@PlanJournalLink">Calcular e registar</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="TogglePlanAsync">Fechar</MudButton>
                </div>
            }

            @if (_alertLinePrice is { } alertPrice)
            {
                <div class="chart-strip">
                    <MudText Typo="Typo.caption">Arrasta a linha laranja até ao preço do alerta:</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="ma-0">@alertPrice.ToString("0.#####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</MudChip>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" OnClick="CreateAlertAsync">Criar alerta</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleAlertLineAsync">Cancelar</MudButton>
                </div>
            }

            @if (_replaying)
            {
                <div class="chart-strip">
                    <MudIconButton Icon="@(_replayPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" Size="Size.Small" aria-label="Reproduzir ou pausar" OnClick="ToggleReplayPlayAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" aria-label="Avançar uma vela" OnClick="StepReplayAsync" Disabled="_replayPlaying" />
                    <MudSlider T="int" Value="_replayIndex" ValueChanged="SeekReplayAsync" Min="@(ReplayMinCandles / 2)" Max="@_fullCandles.Count" Size="Size.Small" Style="max-width:360px" Disabled="_replayPlaying" />
                    <MudText Typo="Typo.caption">vela @_replayIndex / @_fullCandles.Count</MudText>
                    <MudToggleGroup T="int" @bind-Value="_replaySpeed" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary">
                        <MudToggleItem Value="1" Text="1×" />
                        <MudToggleItem Value="2" Text="2×" />
                        <MudToggleItem Value="5" Text="5×" />
                        <MudToggleItem Value="10" Text="10×" />
                    </MudToggleGroup>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="symbol-name">Modo replay: o gráfico mostra só o passado até à vela escolhida.</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="StopReplayAsync">Sair do replay</MudButton>
                </div>
            }

            <div class="chart-body">
                <div class="chart-tools">
                    @foreach (DrawingTool tool in DrawingTools)
                    {
                        <MudTooltip Text="@tool.Label" Placement="Placement.Right">
                            <MudIconButton Icon="@tool.Icon" Size="Size.Small" aria-label="@tool.Label" OnClick="@(() => StartDrawingAsync(tool))" />
                        </MudTooltip>
                    }
                </div>
                <div class="chart-area">
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="ma-4">@_error</MudAlert>
                    }
                    else if (!_ready)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        <KLineChart @ref="_chart" Symbol="@Quote.Symbol" PricePrecision="@PricePrecision" Interval="@_timeframe.Interval" Candles="_candles"
                                    Dark="Theme.IsDark" ShowVolume="@HasVolume" Levels="_allLevels" DrawingsJson="@_drawingsJson" DrawingsChanged="SaveDrawingsAsync" PlanChanged="OnPlanChangedAsync" AlertLineChanged="OnAlertLineChangedAsync" />
                    }
                </div>
            </div>
            @if (_showFlow && Quote.AssetClass == AssetClass.Crypto)
            {
                <div class="pa-2 order-flow-wrap"><OrderFlowPanel Symbol="@Quote.Symbol" /></div>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    private sealed record Timeframe(string Label, string Interval, string Range, string LiveRange);

    private sealed record IndicatorOption(string Name, string Label, bool MainPane);

    private sealed record DrawingTool(string Name, string Label, string Icon);

    private static readonly Timeframe[] Timeframes =
    [
        new("1m", "1m", "5d", "1d"),
        new("2m", "2m", "1mo", "1d"),
        new("5m", "5m", "1mo", "1d"),
        new("15m", "15m", "1mo", "1d"),
        new("30m", "30m", "1mo", "1d"),
        new("1H", "60m", "6mo", "1d"),
        new("1D", "1d", "2y", "5d"),
        new("1W", "1wk", "10y", "1mo"),
        new("1M", "1mo", "max", "6mo")
    ];

    private static readonly IndicatorOption[] Indicators =
    [
        new("MA", "Média móvel (MA)", true),
        new("EMA", "Média móvel exponencial (EMA)", true),
        new("BOLL", "Bandas de Bollinger", true),
        new("SAR", "Parabolic SAR", true),
        new("VOL", "Volume", false),
        new("MACD", "MACD", false),
        new("RSI", "RSI", false),
        new("KDJ", "KDJ / Estocástico", false),
        new("OBV", "On-Balance Volume", false),
        new("CCI", "CCI", false)
    ];

    private static readonly DrawingTool[] DrawingTools =
    [
        new("segment", "Segmento de reta", Icons.Material.Filled.Timeline),
        new("straightLine", "Reta", Icons.Material.Filled.TrendingUp),
        new("rayLine", "Raio", Icons.Material.Filled.CallMade),
        new("horizontalStraightLine", "Linha horizontal", Icons.Material.Filled.HorizontalRule),
        new("verticalStraightLine", "Linha vertical", Icons.Material.Filled.MoreVert),
        new("parallelStraightLine", "Canal paralelo", Icons.Material.Filled.DensityMedium),
        new("priceChannelLine", "Canal de preço", Icons.Material.Filled.Reorder),
        new("fibonacciLine", "Retração de Fibonacci", Icons.Material.Filled.FormatLineSpacing),
        new("rectangle", "Retângulo", Icons.Material.Filled.CropSquare),
        new("priceLine", "Linha de preço", Icons.Material.Filled.AttachMoney),
        new("horizontalRayLine", "Raio horizontal", Icons.Material.Filled.ArrowForward),
        new("arrow", "Seta", Icons.Material.Filled.NorthEast),
        new("circle", "Círculo", Icons.Material.Filled.RadioButtonUnchecked),
        new("triangle", "Triângulo", Icons.Material.Filled.ChangeHistory),
        new("fibonacciExtension", "Extensão de Fibonacci", Icons.Material.Filled.Moving),
        new("brush", "Pincel", Icons.Material.Filled.Brush),
        new("simpleAnnotation", "Nota de texto", Icons.Material.Filled.TextFields),
        new("simpleTag", "Etiqueta de preço", Icons.Material.Filled.Label)
    ];

    private readonly HashSet<string> _activeIndicators = ["VOL"];
    private readonly CancellationTokenSource _cts = new();
    private KLineChart? _chart;
    private IReadOnlyList<Candle> _candles = [];
    private IReadOnlyList<ChartLevel> _levels = [];
    private Timeframe _timeframe = Timeframes[4];
    private string _drawingsJson = "[]";
    private string? _error;
    private string? _liveProblem;
    private IReadOnlyList<InstrumentQuote> _compareOptions = [];
    private IReadOnlyList<ChartTemplate> _templates = [];
    private string? _compareSymbol;
    private HubConnection? _hub;
    private bool _streaming;
    private bool _ready;
    private bool _showFlow;
    private string _cryptoBasis = CryptoBasis.Usd;
    private string _broker = BrokerCatalog.Other;

    [Parameter, EditorRequired] public InstrumentQuote Quote { get; set; } = default!;

    private PriceSourceInfo Source => PriceSources.Describe(Quote.Symbol, Quote.AssetClass, _cryptoBasis);

    private string LiveLabel => Source.Live is { } live ? $"Em direto · {live}" : "Yahoo · pode ter atraso";

    private string SourceTooltip => $"Histórico: {Source.History}. {Source.Note} Última cotação do Yahoo: {DataFreshness.Describe(Quote.AsOf, DateTimeOffset.UtcNow)}.{(BrokerCatalog.LabelOrNull(_broker) is { } broker ? $" Compara com o preço da tua conta na {broker}." : string.Empty)}";

    private bool HasVolume => Quote.AssetClass is not (AssetClass.Forex or AssetClass.Index);

    private int PricePrecision => PriceFormat.Decimals(Quote.AssetClass, Quote.Symbol, Quote.Price);

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;

        if (!HasVolume)
        {
            _activeIndicators.Remove("VOL");
        }

        try
        {
            _drawingsJson = await Api.GetDrawingsAsync(Quote.Symbol, _cts.Token);
            _cryptoBasis = await Api.GetCryptoBasisAsync(_cts.Token);
            _broker = (await Api.GetProfileAsync(_cts.Token)).Broker;
            _candles = await Api.GetCandlesAsync(Quote.Symbol, _timeframe.Interval, _timeframe.Range, _cts.Token);
            _levels = await LoadLevelsAsync();
            RebuildLevels();
            _compareOptions = (await Api.GetInstrumentsAsync(_cts.Token)).Where(q => q.Symbol != Quote.Symbol).ToList();
            _templates = await Api.GetChartTemplatesAsync(_cts.Token);
            _ready = true;
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar o gráfico. Verifica se o servidor está a correr.";
            return;
        }

        _ = RunLiveUpdatesAsync(_cts.Token);
        _ = StartStreamingAsync();
    }

    private async Task<IReadOnlyList<ChartLevel>> LoadLevelsAsync()
    {
        IReadOnlyList<SuggestionDto> open = await Api.GetSuggestionsAsync(Quote.Symbol, true, 1, _cts.Token);

        return open.Count == 0
            ? []
            :
            [
                new ChartLevel("Entrada", open[0].Entry, "#4C8DFF"),
                new ChartLevel("Stop loss", open[0].StopLoss, "#EF4444"),
                new ChartLevel("Take profit", open[0].TakeProfit, "#22C55E")
            ];
    }

    private async Task OpenWhyAsync()
    {
        (DateTimeOffset From, DateTimeOffset To)? visible = _chart is null ? null : await _chart.GetVisibleRangeAsync();
        DialogParameters<WhyDialog> parameters = new()
        {
            { x => x.Symbol, Quote.Symbol },
            { x => x.Name, Quote.Name },
            { x => x.From, visible?.From },
            { x => x.To, visible?.To },
            { x => x.OnMarkers, EventCallback.Factory.Create<IReadOnlyList<MoveCause>>(this, MarkCausesAsync) }
        };

        await DialogService.ShowAsync<WhyDialog>(string.Empty, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task MarkCausesAsync(IReadOnlyList<MoveCause> causes)
    {
        if (_chart is not null)
        {
            await _chart.SetMarkersAsync(causes
                .Select(c => new ChartMarker(c.Time.ToUnixTimeMilliseconds(), $"{c.Id} {CauseClassifier.Label(c.Category)}", c.Confidence == "Alta" ? "#22C55E" : c.Confidence == "Média" ? "#F59E0B" : "#9CA3AF"))
                .ToList());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ready && _chart is not null && !_configApplied)
        {
            await ApplyStoredIndicatorConfigAsync();
        }
    }

    private async Task SelectTimeframeAsync(Timeframe timeframe)
    {
        if (timeframe == _timeframe)
        {
            return;
        }

        if (_replaying)
        {
            await StopReplayAsync();
        }

        try
        {
            IReadOnlyList<Candle> candles = await Api.GetCandlesAsync(Quote.Symbol, timeframe.Interval, timeframe.Range, _cts.Token);
            Timeframe previous = _timeframe;
            _timeframe = timeframe;
            _candles = candles;
            await SwitchSubscriptionAsync(previous, timeframe);
            await ReloadCompareAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível carregar este intervalo.", Severity.Error);
        }
    }

    private async Task SelectCompareAsync(InstrumentQuote option)
    {
        _compareSymbol = option.Symbol;
        await ReloadCompareAsync();
    }

    private async Task ReloadCompareAsync()
    {
        if (_compareSymbol is null || _chart is null)
        {
            return;
        }

        try
        {
            IReadOnlyList<Candle> candles = await Api.GetCandlesAsync(_compareSymbol, _timeframe.Interval, _timeframe.Range, _cts.Token);
            await _chart.SetCompareAsync(_compareSymbol, candles);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível carregar o ativo a comparar.", Severity.Warning);
        }
    }

    private async Task ClearCompareAsync()
    {
        _compareSymbol = null;

        if (_chart is not null)
        {
            await _chart.ClearCompareAsync();
        }
    }

    private async Task SaveTemplateAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<TextPromptDialog>(
            "Guardar modelo",
            new DialogParameters<TextPromptDialog> { { d => d.Title, "Guardar modelo de indicadores" }, { d => d.Label, "Nome do modelo" } });
        DialogResult? result = await dialog.Result;

        if (result is not { Canceled: false, Data: string name })
        {
            return;
        }

        List<ChartTemplate> updated = _templates
            .Where(t => !string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase))
            .Append(new ChartTemplate(name, _activeIndicators.OrderBy(i => i).ToList()))
            .ToList();

        await PersistTemplatesAsync(updated, $"Modelo «{name}» guardado.");
    }

    private async Task DeleteTemplateAsync(ChartTemplate template) =>
        await PersistTemplatesAsync(_templates.Where(t => t.Name != template.Name).ToList(), $"Modelo «{template.Name}» apagado.");

    private async Task PersistTemplatesAsync(List<ChartTemplate> templates, string successMessage)
    {
        string? error = await Api.SaveChartTemplatesAsync(templates, _cts.Token);

        if (error is not null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        _templates = templates;
        Snackbar.Add(successMessage, Severity.Success);
    }

    private async Task ApplyTemplateAsync(ChartTemplate template)
    {
        foreach (IndicatorOption option in Indicators)
        {
            if (template.Indicators.Contains(option.Name) != _activeIndicators.Contains(option.Name))
            {
                await ToggleIndicatorAsync(option);
            }
        }
    }

    private async Task ToggleIndicatorAsync(IndicatorOption indicator)
    {
        if (_chart is null)
        {
            return;
        }

        IReadOnlyList<string> active = await _chart.ToggleIndicatorAsync(indicator.Name, indicator.MainPane);
        _activeIndicators.Clear();
        _activeIndicators.UnionWith(active);
    }

    private async Task StartDrawingAsync(DrawingTool tool)
    {
        if (_chart is not null)
        {
            await _chart.StartDrawingAsync(tool.Name);
        }
    }

    private async Task RemoveSelectedAsync()
    {
        if (_chart is not null)
        {
            await _chart.RemoveSelectedAsync();
        }
    }

    private async Task ClearDrawingsAsync()
    {
        if (_chart is not null)
        {
            await _chart.ClearDrawingsAsync();
        }
    }

    private async Task SaveDrawingsAsync(string json)
    {
        try
        {
            await Api.SaveDrawingsAsync(Quote.Symbol, json, _cts.Token);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível guardar os desenhos.", Severity.Warning);
        }
    }

    private async Task RunLiveUpdatesAsync(CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                Timeframe timeframe = _timeframe;

                if (_streaming || _replaying)
                {
                    continue;
                }

                try
                {
                    IReadOnlyList<Candle> latest = await Api.GetLiveCandlesAsync(Quote.Symbol, timeframe.Interval, timeframe.LiveRange, cancellationToken);

                    if (_chart is null || timeframe != _timeframe)
                    {
                        continue;
                    }

                    await InvokeAsync(async () =>
                    {
                        foreach (Candle candle in latest.TakeLast(2))
                        {
                            await _chart.PushBarAsync(candle);
                        }

                        SetLiveProblem(null);
                    });
                }
                catch (HttpRequestException ex)
                {
                    await InvokeAsync(() => SetLiveProblem(ex.StatusCode == System.Net.HttpStatusCode.NotFound
                        ? "Servidor desatualizado: reinicia-o"
                        : "Sem dados em direto"));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    await InvokeAsync(() => SetLiveProblem("Erro nos dados em direto"));
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task StartStreamingAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Api.NewsHubUrl, options => options.AccessTokenProvider = () => Session.GetAccessTokenAsync())
                .WithAutomaticReconnect()
                .Build();

            _hub.On<LiveCandles>("LiveCandles", OnLiveCandlesAsync);
            _hub.Reconnecting += _ => SetStreamingAsync(false);
            _hub.Reconnected += async _ =>
            {
                await SubscribeAsync(_timeframe);
                await SetStreamingAsync(true);
            };
            _hub.Closed += _ => SetStreamingAsync(false);

            await _hub.StartAsync(_cts.Token);
            await SubscribeAsync(_timeframe);
            _streaming = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            _streaming = false;
        }
    }

    private Task SetStreamingAsync(bool streaming)
    {
        _streaming = streaming;
        return Task.CompletedTask;
    }

    private Task SubscribeAsync(Timeframe timeframe) =>
        _hub is { State: HubConnectionState.Connected }
            ? _hub.InvokeAsync("SubscribeLive", Quote.Symbol, timeframe.Interval, timeframe.LiveRange, _cts.Token)
            : Task.CompletedTask;

    private async Task SwitchSubscriptionAsync(Timeframe previous, Timeframe next)
    {
        if (_hub is not { State: HubConnectionState.Connected })
        {
            return;
        }

        try
        {
            await _hub.InvokeAsync("UnsubscribeLive", Quote.Symbol, previous.Interval, previous.LiveRange, _cts.Token);
            await SubscribeAsync(next);
        }
        catch (Exception ex) when (ex is Microsoft.AspNetCore.SignalR.HubException or OperationCanceledException)
        {
            _streaming = false;
        }
    }

    private Task OnLiveCandlesAsync(LiveCandles message)
    {
        if (_chart is null || _replaying || message.Symbol != Quote.Symbol || message.Interval != _timeframe.Interval)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            foreach (Candle candle in message.Candles.TakeLast(2))
            {
                await _chart.PushBarAsync(candle);
            }

            SetLiveProblem(null);
        });
    }

    private void SetLiveProblem(string? problem)
    {
        if (_liveProblem == problem)
        {
            return;
        }

        _liveProblem = problem;
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        _cts.Cancel();

        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }

        _cts.Dispose();
    }
}
