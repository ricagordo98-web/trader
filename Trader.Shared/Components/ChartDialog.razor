@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject TraderApiClient Api
@inject AuthSession Session
@inject ThemeState Theme
@inject ISnackbar Snackbar

<MudDialog ContentClass="chart-dialog-content">
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <MudText Typo="Typo.h6">@Quote.Symbol</MudText>
            <MudText Typo="Typo.body2" Class="symbol-name">@Quote.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="chart-dialog">
            <div class="chart-toolbar">
                @foreach (Timeframe timeframe in Timeframes)
                {
                    <MudButton Size="Size.Small" Variant="@(timeframe == _timeframe ? Variant.Filled : Variant.Text)" Color="@(timeframe == _timeframe ? Color.Primary : Color.Default)"
                               OnClick="@(() => SelectTimeframeAsync(timeframe))">@timeframe.Label</MudButton>
                }
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                <MudMenu Label="Indicadores" StartIcon="@Icons.Material.Filled.Insights" Size="Size.Small" Variant="Variant.Text" Dense="true">
                    @foreach (IndicatorOption indicator in Indicators)
                    {
                        <MudMenuItem OnClick="@(() => ToggleIndicatorAsync(indicator))">@(_activeIndicators.Contains(indicator.Name) ? "✓ " : "    ")@indicator.Label</MudMenuItem>
                    }
                </MudMenu>
                @foreach (ChartLevel level in _levels)
                {
                    <span class="chart-legend"><span class="chart-legend-dot" style="background:@level.Color"></span>@level.Label @level.Price.ToString(PricePrecision > 3 ? "F5" : "F2", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</span>
                }
                @if (_ready)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(_liveProblem is null ? Color.Success : Color.Warning)" Class="ma-0">
                        @(_liveProblem ?? "Em direto")
                    </MudChip>
                }
                <MudSpacer />
                <MudTooltip Text="Apagar selecionado (Del)">
                    <MudIconButton Icon="@Icons.Material.Filled.Backspace" Size="Size.Small" aria-label="Apagar desenho selecionado" OnClick="RemoveSelectedAsync" />
                </MudTooltip>
                <MudTooltip Text="Apagar todos os desenhos">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" aria-label="Apagar todos os desenhos" OnClick="ClearDrawingsAsync" />
                </MudTooltip>
            </div>
            <div class="chart-body">
                <div class="chart-tools">
                    @foreach (DrawingTool tool in DrawingTools)
                    {
                        <MudTooltip Text="@tool.Label" Placement="Placement.Right">
                            <MudIconButton Icon="@tool.Icon" Size="Size.Small" aria-label="@tool.Label" OnClick="@(() => StartDrawingAsync(tool))" />
                        </MudTooltip>
                    }
                </div>
                <div class="chart-area">
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="ma-4">@_error</MudAlert>
                    }
                    else if (!_ready)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        <KLineChart @ref="_chart" Symbol="@Quote.Symbol" PricePrecision="@PricePrecision" Interval="@_timeframe.Interval" Candles="_candles"
                                    Dark="Theme.IsDark" ShowVolume="@HasVolume" Levels="_levels" DrawingsJson="@_drawingsJson" DrawingsChanged="SaveDrawingsAsync" />
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    private sealed record Timeframe(string Label, string Interval, string Range, string LiveRange);

    private sealed record IndicatorOption(string Name, string Label, bool MainPane);

    private sealed record DrawingTool(string Name, string Label, string Icon);

    private static readonly Timeframe[] Timeframes =
    [
        new("1m", "1m", "5d", "1d"),
        new("2m", "2m", "1mo", "1d"),
        new("5m", "5m", "1mo", "1d"),
        new("15m", "15m", "1mo", "1d"),
        new("30m", "30m", "1mo", "1d"),
        new("1H", "60m", "6mo", "1d"),
        new("1D", "1d", "2y", "5d"),
        new("1W", "1wk", "10y", "1mo"),
        new("1M", "1mo", "max", "6mo")
    ];

    private static readonly IndicatorOption[] Indicators =
    [
        new("MA", "Média móvel (MA)", true),
        new("EMA", "Média móvel exponencial (EMA)", true),
        new("BOLL", "Bandas de Bollinger", true),
        new("SAR", "Parabolic SAR", true),
        new("VOL", "Volume", false),
        new("MACD", "MACD", false),
        new("RSI", "RSI", false),
        new("KDJ", "KDJ / Estocástico", false),
        new("OBV", "On-Balance Volume", false),
        new("CCI", "CCI", false)
    ];

    private static readonly DrawingTool[] DrawingTools =
    [
        new("segment", "Segmento de reta", Icons.Material.Filled.Timeline),
        new("straightLine", "Reta", Icons.Material.Filled.TrendingUp),
        new("rayLine", "Raio", Icons.Material.Filled.CallMade),
        new("horizontalStraightLine", "Linha horizontal", Icons.Material.Filled.HorizontalRule),
        new("verticalStraightLine", "Linha vertical", Icons.Material.Filled.MoreVert),
        new("parallelStraightLine", "Canal paralelo", Icons.Material.Filled.DensityMedium),
        new("priceChannelLine", "Canal de preço", Icons.Material.Filled.Reorder),
        new("fibonacciLine", "Retração de Fibonacci", Icons.Material.Filled.FormatLineSpacing),
        new("rectangle", "Retângulo", Icons.Material.Filled.CropSquare),
        new("priceLine", "Linha de preço", Icons.Material.Filled.AttachMoney)
    ];

    private readonly HashSet<string> _activeIndicators = ["VOL"];
    private readonly CancellationTokenSource _cts = new();
    private KLineChart? _chart;
    private IReadOnlyList<Candle> _candles = [];
    private IReadOnlyList<ChartLevel> _levels = [];
    private Timeframe _timeframe = Timeframes[4];
    private string _drawingsJson = "[]";
    private string? _error;
    private string? _liveProblem;
    private HubConnection? _hub;
    private bool _streaming;
    private bool _ready;

    [Parameter, EditorRequired] public InstrumentQuote Quote { get; set; } = default!;

    private bool HasVolume => Quote.AssetClass != AssetClass.Forex;

    private int PricePrecision => Quote.AssetClass == AssetClass.Forex
        ? (Quote.Symbol.Contains("JPY", StringComparison.Ordinal) ? 3 : 5)
        : 2;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;

        if (!HasVolume)
        {
            _activeIndicators.Remove("VOL");
        }

        try
        {
            _drawingsJson = await Api.GetDrawingsAsync(Quote.Symbol, _cts.Token);
            _candles = await Api.GetCandlesAsync(Quote.Symbol, _timeframe.Interval, _timeframe.Range, _cts.Token);
            _levels = await LoadLevelsAsync();
            _ready = true;
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar o gráfico. Verifica se o servidor está a correr.";
            return;
        }

        _ = RunLiveUpdatesAsync(_cts.Token);
        _ = StartStreamingAsync();
    }

    private async Task<IReadOnlyList<ChartLevel>> LoadLevelsAsync()
    {
        IReadOnlyList<SuggestionDto> open = await Api.GetSuggestionsAsync(Quote.Symbol, true, 1, _cts.Token);

        return open.Count == 0
            ? []
            :
            [
                new ChartLevel("Entrada", open[0].Entry, "#4C8DFF"),
                new ChartLevel("Stop loss", open[0].StopLoss, "#EF4444"),
                new ChartLevel("Take profit", open[0].TakeProfit, "#22C55E")
            ];
    }

    private async Task SelectTimeframeAsync(Timeframe timeframe)
    {
        if (timeframe == _timeframe)
        {
            return;
        }

        try
        {
            IReadOnlyList<Candle> candles = await Api.GetCandlesAsync(Quote.Symbol, timeframe.Interval, timeframe.Range, _cts.Token);
            Timeframe previous = _timeframe;
            _timeframe = timeframe;
            _candles = candles;
            await SwitchSubscriptionAsync(previous, timeframe);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível carregar este intervalo.", Severity.Error);
        }
    }

    private async Task ToggleIndicatorAsync(IndicatorOption indicator)
    {
        if (_chart is null)
        {
            return;
        }

        IReadOnlyList<string> active = await _chart.ToggleIndicatorAsync(indicator.Name, indicator.MainPane);
        _activeIndicators.Clear();
        _activeIndicators.UnionWith(active);
    }

    private async Task StartDrawingAsync(DrawingTool tool)
    {
        if (_chart is not null)
        {
            await _chart.StartDrawingAsync(tool.Name);
        }
    }

    private async Task RemoveSelectedAsync()
    {
        if (_chart is not null)
        {
            await _chart.RemoveSelectedAsync();
        }
    }

    private async Task ClearDrawingsAsync()
    {
        if (_chart is not null)
        {
            await _chart.ClearDrawingsAsync();
        }
    }

    private async Task SaveDrawingsAsync(string json)
    {
        try
        {
            await Api.SaveDrawingsAsync(Quote.Symbol, json, _cts.Token);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível guardar os desenhos.", Severity.Warning);
        }
    }

    private async Task RunLiveUpdatesAsync(CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                Timeframe timeframe = _timeframe;

                if (_streaming)
                {
                    continue;
                }

                try
                {
                    IReadOnlyList<Candle> latest = await Api.GetLiveCandlesAsync(Quote.Symbol, timeframe.Interval, timeframe.LiveRange, cancellationToken);

                    if (_chart is null || timeframe != _timeframe)
                    {
                        continue;
                    }

                    await InvokeAsync(async () =>
                    {
                        foreach (Candle candle in latest.TakeLast(2))
                        {
                            await _chart.PushBarAsync(candle);
                        }

                        SetLiveProblem(null);
                    });
                }
                catch (HttpRequestException ex)
                {
                    await InvokeAsync(() => SetLiveProblem(ex.StatusCode == System.Net.HttpStatusCode.NotFound
                        ? "Servidor desatualizado: reinicia-o"
                        : "Sem dados em direto"));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    await InvokeAsync(() => SetLiveProblem("Erro nos dados em direto"));
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task StartStreamingAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Api.NewsHubUrl, options => options.AccessTokenProvider = () => Session.GetAccessTokenAsync())
                .WithAutomaticReconnect()
                .Build();

            _hub.On<LiveCandles>("LiveCandles", OnLiveCandlesAsync);
            _hub.Reconnecting += _ => SetStreamingAsync(false);
            _hub.Reconnected += async _ =>
            {
                await SubscribeAsync(_timeframe);
                await SetStreamingAsync(true);
            };
            _hub.Closed += _ => SetStreamingAsync(false);

            await _hub.StartAsync(_cts.Token);
            await SubscribeAsync(_timeframe);
            _streaming = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            _streaming = false;
        }
    }

    private Task SetStreamingAsync(bool streaming)
    {
        _streaming = streaming;
        return Task.CompletedTask;
    }

    private Task SubscribeAsync(Timeframe timeframe) =>
        _hub is { State: HubConnectionState.Connected }
            ? _hub.InvokeAsync("SubscribeLive", Quote.Symbol, timeframe.Interval, timeframe.LiveRange, _cts.Token)
            : Task.CompletedTask;

    private async Task SwitchSubscriptionAsync(Timeframe previous, Timeframe next)
    {
        if (_hub is not { State: HubConnectionState.Connected })
        {
            return;
        }

        try
        {
            await _hub.InvokeAsync("UnsubscribeLive", Quote.Symbol, previous.Interval, previous.LiveRange, _cts.Token);
            await SubscribeAsync(next);
        }
        catch (Exception ex) when (ex is Microsoft.AspNetCore.SignalR.HubException or OperationCanceledException)
        {
            _streaming = false;
        }
    }

    private Task OnLiveCandlesAsync(LiveCandles message)
    {
        if (_chart is null || message.Symbol != Quote.Symbol || message.Interval != _timeframe.Interval)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            foreach (Candle candle in message.Candles.TakeLast(2))
            {
                await _chart.PushBarAsync(candle);
            }

            SetLiveProblem(null);
        });
    }

    private void SetLiveProblem(string? problem)
    {
        if (_liveProblem == problem)
        {
            return;
        }

        _liveProblem = problem;
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        _cts.Cancel();

        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }

        _cts.Dispose();
    }
}
