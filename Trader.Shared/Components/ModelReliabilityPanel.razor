@using System.Globalization
@implements IDisposable
@inject TraderApiClient Api

<div class="d-flex align-center flex-wrap gap-3 mb-3">
    <MudText Typo="Typo.subtitle1">Fiabilidade do modelo</MudText>
    <MudSpacer />
    <MudToggleGroup T="SuggestionHorizon?" Value="_horizon" ValueChanged="SetHorizonAsync" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary">
        <MudToggleItem Value="@((SuggestionHorizon?)null)" Text="Todas" />
        <MudToggleItem Value="@((SuggestionHorizon?)SuggestionHorizon.Intraday)" Text="Intraday" />
        <MudToggleItem Value="@((SuggestionHorizon?)SuggestionHorizon.Swing)" Text="Swing" />
    </MudToggleGroup>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">@_error</MudAlert>
}

@if (_report is { } report)
{
    <MudAlert Severity="@VerdictSeverity(report.Verdict.Level)" Variant="Variant.Outlined" Class="mb-4">
        <MudText Typo="Typo.subtitle2">@report.Verdict.Title</MudText>
        @foreach (string reason in report.Verdict.Reasons)
        {
            <MudText Typo="Typo.body2">@reason</MudText>
        }
    </MudAlert>

    @if (report.Closed > 0)
    {
        <MudGrid Spacing="3" Class="mb-2">
            @foreach ((string label, string value, string hint) in Kpis(report))
            {
                <MudItem xs="6" md="4" lg="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudText Typo="Typo.caption" Class="symbol-name">@label</MudText>
                        <MudText Typo="Typo.h5">@value</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name">@hint</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Como terminam as sugestões</MudText>
            <div class="outcome-bar" role="img" aria-label="Distribuição dos resultados">
                <div style="@($"width:{Share(report.TakeProfitHits, report.Closed)}%;background:var(--mud-palette-success)")" title="Take profit"></div>
                <div style="@($"width:{Share(report.Expired, report.Closed)}%;background:var(--mud-palette-gray-default)")" title="Expiradas"></div>
                <div style="@($"width:{Share(report.StopLossHits, report.Closed)}%;background:var(--mud-palette-error)")" title="Stop loss"></div>
            </div>
            <div class="d-flex flex-wrap gap-4 mt-2">
                <MudText Typo="Typo.body2" Color="Color.Success">Take profit: @report.TakeProfitHits (@Percent(report.TakeProfitHits, report.Closed))</MudText>
                <MudText Typo="Typo.body2" Color="Color.Error">Stop loss: @report.StopLossHits (@Percent(report.StopLossHits, report.Closed))</MudText>
                <MudText Typo="Typo.body2" Class="symbol-name">Expiradas: @report.Expired (@Percent(report.Expired, report.Closed))</MudText>
            </div>
            <MudText Typo="Typo.caption" Class="symbol-name d-block mt-2">
                Tempo médio até fechar @Hours(report.AverageHoursToClose) · até ao alvo @Hours(report.AverageHoursToTakeProfit) · até ao stop @Hours(report.AverageHoursToStopLoss).
                Ganho médio @report.AverageWinR.ToString("+0.00;-0.00;0.00", Pt) R · perda média @report.AverageLossR.ToString("+0.00;-0.00;0.00", Pt) R.
            </MudText>
        </MudPaper>

        <MudGrid Spacing="3" Class="mb-2">
            @foreach ((string title, IReadOnlyList<ReliabilityStat> stats, string note) in Tables(report))
            {
                @if (stats.Count > 0)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                            <MudText Typo="Typo.subtitle1" Class="mb-1">@title</MudText>
                            <MudText Typo="Typo.caption" Class="symbol-name d-block mb-2">@note</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <thead><tr><th></th><th>N</th><th>Acerto</th><th>Intervalo 95%</th><th>R médio</th></tr></thead>
                                <tbody>
                                    @foreach (ReliabilityStat stat in stats)
                                    {
                                        <tr>
                                            <td>@stat.Name</td>
                                            <td>@stat.Count</td>
                                            <td>@stat.WinRate.ToString("P0", Pt)</td>
                                            <td>@stat.WinRateCi.Low.ToString("P0", Pt) – @stat.WinRateCi.High.ToString("P0", Pt)</td>
                                            <td>@stat.AverageR.ToString("+0.00;-0.00;0.00", Pt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>
                }
            }
        </MudGrid>
    }

    @if (report.Excursions is { } excursions)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-2">
            <MudText Typo="Typo.subtitle1" Class="mb-1">Até onde vai o preço depois da entrada (@excursions.Samples sugestões)</MudText>
            <MudText Typo="Typo.body2">
                Ganho máximo típico: @excursions.MedianMfeR.ToString("0.00", Pt) R · queda máxima típica: @excursions.MedianMaeR.ToString("0.00", Pt) R.
                Dos stops, @excursions.StoppedReachedHalfTargetShare.ToString("P0", Pt) tinham chegado a metade do caminho para o alvo antes de virar.
            </MudText>
            <MudText Typo="Typo.caption" Class="symbol-name d-block mt-1">@excursions.Hint</MudText>
        </MudPaper>
    }

    @if (report.SmartExit is { } smart)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-2">
            <MudText Typo="Typo.subtitle1" Class="mb-1">Saída fixa contra saída inteligente (@smart.Samples sugestões)</MudText>
            <MudText Typo="Typo.body2">
                R médio com stop e alvo fixos: @smart.FixedAverageR.ToString("+0.00;-0.00;0.00", Pt) · com saída parcial, breakeven e trailing: @smart.SmartAverageR.ToString("+0.00;-0.00;0.00", Pt)
                (@smart.DifferenceR.ToString("+0.00;-0.00;0.00", Pt) R).
            </MudText>
            <MudText Typo="Typo.caption" Class="symbol-name d-block mt-1">@smart.Hint</MudText>
        </MudPaper>
    }

    @if (report.Shadow is { } shadow && (shadow.Hidden is not null || shadow.ByReason.Count > 0))
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-2">
            <MudText Typo="Typo.subtitle1" Class="mb-1">As regras estão a ajudar? (mostradas contra só em registo)</MudText>
            <MudText Typo="Typo.caption" Class="symbol-name d-block mb-2">
                As sugestões que falham uma regra ficam gravadas e são avaliadas como as outras. Se as de sombra acertam menos que as mostradas, a regra está a filtrar bem; se acertam igual ou mais, a regra está a deitar fora boas ideias.
            </MudText>
            <MudSimpleTable Dense="true" Elevation="0">
                <thead><tr><th></th><th>N</th><th>Acerto</th><th>Intervalo 95%</th><th>R médio</th></tr></thead>
                <tbody>
                    @foreach (ReliabilityStat stat in new[] { shadow.Shown, shadow.Hidden }.OfType<ReliabilityStat>().Concat(shadow.ByReason))
                    {
                        <tr>
                            <td>@(shadow.ByReason.Contains(stat) ? "↳ " : string.Empty)@stat.Name</td>
                            <td>@stat.Count</td>
                            <td>@stat.WinRate.ToString("P0", Pt)</td>
                            <td>@stat.WinRateCi.Low.ToString("P0", Pt) – @stat.WinRateCi.High.ToString("P0", Pt)</td>
                            <td>@stat.AverageR.ToString("+0.00;-0.00;0.00", Pt)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}
else if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}

<MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-2">
    <div class="d-flex align-center flex-wrap gap-3">
        <MudText Typo="Typo.subtitle1">Aprender os pesos dos sinais</MudText>
        <MudSpacer />
        <MudToggleGroup T="SuggestionHorizon" Value="_learnHorizon" ValueChanged="SetLearnHorizonAsync" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary">
            <MudToggleItem Value="SuggestionHorizon.Intraday" Text="Intraday" />
            <MudToggleItem Value="SuggestionHorizon.Swing" Text="Swing" />
        </MudToggleGroup>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_learnBusy" OnClick="LearnAsync">Calcular proposta</MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="symbol-name d-block mb-2">
        Com 150 ou mais sugestões fechadas, ajusta o peso de cada sinal pelo acerto real. A proposta aprende nos 70% mais antigos e só é aplicável se melhorar a separação entre ganhos e perdas nos 30% mais recentes, que não foram usados a aprender.
    </MudText>
    @if (_learning is { } learning)
    {
        <MudAlert Severity="@(learning.Validated ? Severity.Success : Severity.Info)" Variant="Variant.Outlined" Class="mb-2">@learning.Message</MudAlert>

        @if (learning.Weights.Count > 0)
        {
            <MudSimpleTable Dense="true" Elevation="0">
                <thead><tr><th>Sinal</th><th>N</th><th>Vantagem face à média</th><th>Peso atual</th><th>Peso proposto</th></tr></thead>
                <tbody>
                    @foreach (LearnedWeight weight in learning.Weights)
                    {
                        <tr>
                            <td>@weight.Label</td>
                            <td>@weight.Samples</td>
                            <td>@weight.Lift.ToString("+0.0%;-0.0%;0.0%", Pt)</td>
                            <td>@weight.CurrentWeight.ToString("0.00", Pt)</td>
                            <td>@weight.ProposedWeight.ToString("0.00", Pt)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="@(!learning.Validated || _learnBusy)" OnClick="ApplyLearningAsync">Aplicar pesos validados</MudButton>
        }
    }
</MudPaper>

<MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-2">
    <div class="d-flex align-center gap-3">
        <MudText Typo="Typo.subtitle1">Captação de sentimento das notícias</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_studyBusy" OnClick="RunStudyAsync">@(_study is null ? "Analisar" : "Atualizar")</MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="symbol-name d-block mb-2">
        Compara o sentimento de cada notícia (modelo FinBERT) com o que o preço fez depois, nos últimos 90 dias. Usa o fecho do dia da notícia como base, por isso mede se o sentimento antecipa o preço e não se apenas o acompanha.
    </MudText>

    @if (_studyBusy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_study is { } study)
    {
        <MudAlert Severity="@VerdictSeverity(study.Verdict.Level)" Variant="Variant.Outlined" Class="mb-3">
            <MudText Typo="Typo.subtitle2">@study.Verdict.Title</MudText>
            @foreach (string reason in study.Verdict.Reasons)
            {
                <MudText Typo="Typo.body2">@reason</MudText>
            }
        </MudAlert>

        <MudSimpleTable Dense="true" Elevation="0">
            <thead><tr><th>Horizonte</th><th>Notícias</th><th>Sentido certo</th><th>Intervalo 95%</th><th>Correlação</th><th>Retorno médio (sent. +)</th><th>Retorno médio (sent. −)</th></tr></thead>
            <tbody>
                @foreach (SentimentHorizonResult h in study.Horizons)
                {
                    <tr>
                        <td>@h.Label</td>
                        <td>@h.Samples</td>
                        <td>@h.HitRate.ToString("P0", Pt)</td>
                        <td>@h.HitRateCi.Low.ToString("P0", Pt) – @h.HitRateCi.High.ToString("P0", Pt)</td>
                        <td>@(h.Correlation?.ToString("+0.00;-0.00;0.00", Pt) ?? "—")</td>
                        <td>@h.AverageReturnPositive.ToString("+0.00%;-0.00%;0.00%", Pt)</td>
                        <td>@h.AverageReturnNegative.ToString("+0.00%;-0.00%;0.00%", Pt)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

<MudText Typo="Typo.caption" Class="symbol-name d-block mt-3">
    Como ler: o intervalo de 95% diz onde o acerto verdadeiro deve estar; quanto mais sugestões fechadas, mais estreito. O ponto de equilíbrio é o acerto mínimo para não perder dinheiro com o R:R médio.
    Esta análise mede o passado: não garante resultados futuros nem é aconselhamento financeiro.
</MudText>

@code {
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-PT");

    private readonly CancellationTokenSource _cts = new();
    private ModelReliabilityReport? _report;
    private SentimentStudyResult? _study;
    private SuggestionHorizon? _horizon;
    private string? _error;
    private bool _loading = true;
    private bool _studyBusy;
    private SuggestionHorizon _learnHorizon = SuggestionHorizon.Intraday;
    private WeightLearning? _learning;
    private bool _learnBusy;

    private async Task SetLearnHorizonAsync(SuggestionHorizon horizon)
    {
        _learnHorizon = horizon;
        _learning = null;
        await LearnAsync();
    }

    private async Task LearnAsync()
    {
        _learnBusy = true;

        try
        {
            _learning = await Api.GetWeightLearningAsync(_learnHorizon, _cts.Token);
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível calcular a proposta de pesos.";
        }
        finally
        {
            _learnBusy = false;
        }
    }

    private async Task ApplyLearningAsync()
    {
        _learnBusy = true;

        try
        {
            _learning = await Api.ApplyWeightLearningAsync(_learnHorizon, _cts.Token);
            _error = null;
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível aplicar os pesos.";
        }
        finally
        {
            _learnBusy = false;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SetHorizonAsync(SuggestionHorizon? horizon)
    {
        _horizon = horizon;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _report = await Api.GetReliabilityAsync(_horizon, _cts.Token);
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível calcular a fiabilidade. Verifica se o servidor está a correr.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunStudyAsync()
    {
        _studyBusy = true;

        try
        {
            _study = await Api.GetSentimentStudyAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível analisar o sentimento agora.";
        }
        finally
        {
            _studyBusy = false;
        }
    }

    private static Severity VerdictSeverity(ReliabilityLevel level) => level switch
    {
        ReliabilityLevel.High or ReliabilityLevel.Moderate => Severity.Success,
        ReliabilityLevel.Unproven => Severity.Info,
        ReliabilityLevel.NoEdge => Severity.Warning,
        _ => Severity.Normal
    };

    private IEnumerable<(string, string, string)> Kpis(ModelReliabilityReport r)
    {
        yield return ("Sugestões fechadas", r.Closed.ToString(Pt), "amostra usada");
        yield return ("Acerto (lucro)", r.WinRate.ToString("P0", Pt), $"IC 95%: {r.WinRateCi.Low.ToString("P0", Pt)} – {r.WinRateCi.High.ToString("P0", Pt)}");
        yield return ("Ponto de equilíbrio", r.BreakEvenWinRate.ToString("P0", Pt), r.WinRate >= r.BreakEvenWinRate ? "acima do mínimo necessário" : "abaixo do mínimo necessário");
        yield return ("R médio líquido", r.AverageR.ToString("+0.00;-0.00;0.00", Pt), $"IC 95%: {r.AverageRCi.Low.ToString("+0.00;-0.00;0.00", Pt)} a {r.AverageRCi.High.ToString("+0.00;-0.00;0.00", Pt)}");
        yield return ("R médio bruto e custos", r.AverageGrossR.ToString("+0.00;-0.00;0.00", Pt), $"menos {r.AverageCostR.ToString("0.00", Pt)} R de spread e comissões (estimativa)");
        yield return ("Profit factor", r.ProfitFactor?.ToString("0.00", Pt) ?? "—", "ganhos totais / perdas totais");
        yield return ("Certeza média indicada", r.AverageConfidence.ToString("P0", Pt), $"acerto real {r.WinRate.ToString("P0", Pt)}");
        yield return ("Erro de calibração", r.CalibrationError.ToString("P1", Pt), "diferença média entre certeza e acerto (menor é melhor)");
        yield return ("Brier", r.BrierScore.ToString("0.000", Pt), $"palpite à média: {r.BaselineBrier.ToString("0.000", Pt)} (menor é melhor)");
    }

    private static IEnumerable<(string, IReadOnlyList<ReliabilityStat>, string)> Tables(ModelReliabilityReport r)
    {
        yield return ("Por horizonte", r.ByHorizon, "Intraday (horas) contra swing (dias).");
        yield return ("Por direção", r.ByDirection, "Compra contra venda.");
        yield return ("Por faixa de certeza", r.ByConfidence, "Certezas mais altas deviam acertar mais.");
        yield return ("Por tipo de ativo", r.ByAssetClass ?? [], "O acerto de cripto, ações e mercadorias costuma ser muito diferente. A certeza calibrada usa o histórico do próprio tipo quando há amostra.");
        yield return ("Por hora de criação", r.ByHour ?? [], "Hora local em que a sugestão nasceu.");
        yield return ("Variante A contra B", r.ByVariant ?? [], "A variante B é a segunda versão das regras que corre em sombra (Configurações → Scoring).");
        yield return ("Sentimento a favor ou contra", r.BySentiment, "O acerto quando as notícias apontavam no mesmo sentido da sugestão, e quando apontavam ao contrário.");
    }

    private static double Share(int part, int total) => total == 0 ? 0 : Math.Round(part * 100.0 / total, 1);

    private static string Percent(int part, int total) => total == 0 ? "0%" : (part / (double)total).ToString("P0", Pt);

    private static string Hours(double hours) => hours <= 0 ? "—" : hours >= 48 ? $"{hours / 24:0.#} d" : $"{hours:0.#} h";

    public void Dispose() => _cts.Cancel();
}
