@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Theme
@inject AuthSession Session
@inject IClientStore Store
@inject IDialogService DialogService

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="IsDark" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_ready)
{
    <div class="splash"><span class="trader-brand">TRADER</span></div>
}
else if (!Session.IsAuthenticated)
{
    <LoginView />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0" Class="trader-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="nav-toggle" aria-label="Abrir menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="trader-brand">TRADER</MudText>
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="symbol-name d-none d-sm-block mr-2">@Session.Email</MudText>
            <AlertBell />
            <MudTooltip Text="@(IsDark ? "Tema claro" : "Tema escuro")">
                <MudIconButton Icon="@(IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" aria-label="Alternar tema" OnClick="ToggleThemeAsync" />
            </MudTooltip>
            <MudTooltip Text="Terminar sessão">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Terminar sessão" OnClick="Session.LogoutAsync" />
            </MudTooltip>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always" Class="trader-drawer">
            <NavMenu />
        </MudDrawer>
        <MudMainContent Class="trader-main">
            @Body
            <BottomNav />
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private MudTheme _theme = TraderTheme.Create(ThemeState.Accents[0]);
    private AccentOption _themeAccent = ThemeState.Accents[0];
    private bool _drawerOpen = true;
    private bool _ready;

    private bool IsDark
    {
        get => Theme.IsDark;
        set => Theme.IsDark = value;
    }

    protected override void OnInitialized()
    {
        Theme.Changed += OnStateChanged;
        Session.Changed += OnStateChanged;
    }

    private bool _tourChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_ready && Session.IsAuthenticated && !_tourChecked)
            {
                _tourChecked = true;
                await ShowTourIfFirstRunAsync();
            }

            return;
        }

        await Session.InitializeAsync();
        await Theme.LoadAsync(Store);

        if (Theme.Mode == ThemeMode.System && _themeProvider is not null)
        {
            await Theme.SetModeAsync(Store, ThemeMode.System, await _themeProvider.GetSystemDarkModeAsync());
        }

        _ready = true;
        StateHasChanged();
    }

    private async Task ShowTourIfFirstRunAsync()
    {
        try
        {
            if (await Store.GetAsync(TourDialog.StoreKey) is null)
            {
                await DialogService.ShowAsync<TourDialog>(string.Empty, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
            }
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task ToggleThemeAsync() =>
        await Theme.SetModeAsync(Store, IsDark ? ThemeMode.Light : ThemeMode.Dark, false);

    private void OnStateChanged()
    {
        if (Theme.Accent != _themeAccent)
        {
            _themeAccent = Theme.Accent;
            _theme = TraderTheme.Create(_themeAccent);
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.Changed -= OnStateChanged;
        Session.Changed -= OnStateChanged;
    }
}
