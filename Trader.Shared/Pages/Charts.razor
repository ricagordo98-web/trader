@page "/charts"
@using System.Text.Json
@implements IAsyncDisposable
@inject TraderApiClient Api
@inject IClientStore Store
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Gráficos · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 page-fade">
    <div class="charts-toolbar mb-3">
        <MudText Typo="Typo.h4">Gráficos</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddChart" OnClick="AddAsync" Disabled="@(_instruments.Count == 0)">Adicionar gráfico</MudButton>
        <MudMenu Label="Organizar" StartIcon="@Icons.Material.Filled.GridView" Variant="Variant.Outlined" Dense="true" Disabled="@(_panels.Count == 0)">
            <MudMenuItem OnClick="@(() => ArrangeAsync(WorkspaceLayout.AutoColumns(_panels.Count)))">Grelha automática</MudMenuItem>
            <MudMenuItem OnClick="@(() => ArrangeAsync(1))">1 coluna</MudMenuItem>
            <MudMenuItem OnClick="@(() => ArrangeAsync(2))">2 colunas</MudMenuItem>
            <MudMenuItem OnClick="@(() => ArrangeAsync(3))">3 colunas</MudMenuItem>
            <MudMenuItem OnClick="CascadeAsync">Em cascata</MudMenuItem>
        </MudMenu>
        <MudMenu Label="Disposições" StartIcon="@Icons.Material.Filled.Bookmarks" Variant="Variant.Outlined" Dense="true">
            <MudMenuItem OnClick="SaveLayoutAsync">Guardar a disposição atual…</MudMenuItem>
            @if (_layouts.Count > 0)
            {
                <MudDivider />
                @foreach (ChartLayoutDto item in _layouts)
                {
                    <MudMenuItem OnClick="@(() => LoadLayoutAsync(item))">@(item.Name)</MudMenuItem>
                }
                <MudDivider />
                @foreach (ChartLayoutDto item in _layouts)
                {
                    <MudMenuItem OnClick="@(() => DeleteLayoutAsync(item))">✕ Apagar «@(item.Name)»</MudMenuItem>
                }
            }
        </MudMenu>
        <MudTooltip Text="Sincroniza o cursor e a posição horizontal entre os gráficos">
            <MudButton Variant="@(_sync ? Variant.Filled : Variant.Outlined)" Color="@(_sync ? Color.Primary : Color.Default)" StartIcon="@Icons.Material.Filled.Sync" OnClick="ToggleSyncAsync" Disabled="@(_panels.Count < 2)">Sincronizar</MudButton>
        </MudTooltip>
        <MudButton Variant="@(_soloId is null ? Variant.Outlined : Variant.Filled)" Color="@(_soloId is null ? Color.Default : Color.Primary)"
                   StartIcon="@(_soloId is null ? Icons.Material.Filled.Fullscreen : Icons.Material.Filled.FullscreenExit)" OnClick="ToggleSoloTopAsync" Disabled="@(_panels.Count == 0)">
            @(_soloId is null ? "Só um gráfico" : "Mostrar todos")
        </MudButton>
        <MudTooltip Text="Remover todos os gráficos">
            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Disabled="@(_panels.Count == 0)" OnClick="ClearAsync" aria-label="Remover todos os gráficos" />
        </MudTooltip>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_instruments.Count == 0)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudText Typo="Typo.caption" Class="symbol-name d-block mb-2">
            Arrasta um gráfico pelo cabeçalho para o mover e puxa o canto inferior direito para mudar o tamanho. A disposição fica guardada neste dispositivo.
        </MudText>

        <div @ref="_workspace" class="ws" style="@($"min-height:{_contentHeight:0}px")">
            @if (_panels.Count == 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center">
                    <MudText Typo="Typo.h6" Class="mb-2">Sem gráficos</MudText>
                    <MudText Color="Color.Secondary" Class="mb-4">Adiciona os ativos que queres acompanhar, organizados por tipo.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddChart" OnClick="AddAsync">Adicionar gráfico</MudButton>
                </MudPaper>
            }

            @foreach (WorkspacePanel panel in VisiblePanels)
            {
                bool solo = panel.Id == _soloId;

                <div @key="panel.Id" class="@($"ws-panel{(solo ? " maximized" : string.Empty)}")" data-panel-id="@panel.Id" style="@PanelStyle(panel, solo)">
                    <ChartPanel Symbol="@panel.Symbol" TimeframeIndex="panel.Timeframe" Instruments="_instruments" Maximized="solo" SyncGroup="@(_sync ? "workspace" : null)"
                                SymbolChanged="@(symbol => UpdatePanelAsync(panel, symbol, null))"
                                TimeframeChanged="@(timeframe => UpdatePanelAsync(panel, null, timeframe))"
                                OnToggleMaximize="@(() => ToggleSoloAsync(panel.Id))"
                                OnClose="@(() => RemoveAsync(panel))" />
                    @if (!solo)
                    {
                        <div class="ws-resize" title="Redimensionar"></div>
                    }
                </div>
            }
        </div>
    }
</MudContainer>

@code {
    private const string StoreKey = "charts.workspace.v2";
    private const string SyncKey = "charts.sync";
    private const int DefaultPanels = 4;

    private sealed record SavedWorkspace(List<WorkspacePanel> Panels, bool Auto);

    private readonly CancellationTokenSource _cts = new();
    private readonly string _id = Guid.NewGuid().ToString("N");
    private IReadOnlyList<InstrumentQuote> _instruments = [];
    private List<WorkspacePanel> _panels = [];
    private ElementReference _workspace;
    private DotNetObjectReference<Charts>? _self;
    private IJSObjectReference? _module;
    private Guid? _soloId;
    private bool _auto = true;
    private bool _needsArrange;
    private bool _ready;
    private double _width = 1200;
    private double _height = 700;
    private double _contentHeight = 700;
    private int _topZ = 10;
    private string? _error;
    private bool _sync;
    private IReadOnlyList<ChartLayoutDto> _layouts = [];

    private IEnumerable<WorkspacePanel> VisiblePanels => _soloId is { } solo ? _panels.Where(p => p.Id == solo) : _panels;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _instruments = await Api.GetInstrumentsAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível obter a watchlist. Verifica se o servidor está a correr.";
            return;
        }

        try
        {
            _layouts = await Api.GetChartLayoutsAsync(_cts.Token);
        }
        catch (HttpRequestException)
        {
        }

        _sync = await Store.GetAsync(SyncKey) == "1";
        SavedWorkspace? saved = await LoadSavedAsync();
        HashSet<string> known = _instruments.Select(i => i.Symbol).ToHashSet();

        if (saved is not null)
        {
            _panels = saved.Panels.Where(p => known.Contains(p.Symbol)).ToList();
            _panels.ForEach(WorkspaceLayout.Normalize);
            _auto = saved.Auto;
        }
        else
        {
            _panels = _instruments.Take(DefaultPanels).Select(i => new WorkspacePanel { Symbol = i.Symbol }).ToList();
            _needsArrange = true;
        }

        _topZ = _panels.Count == 0 ? 10 : _panels.Max(p => p.Z) + 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ready || _instruments.Count == 0 || _error is not null)
        {
            return;
        }

        _ready = true;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Trader.Shared/js/workspace.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", _id, _workspace, _self);
        await MeasureAsync();

        if (_needsArrange)
        {
            _needsArrange = false;
            WorkspaceLayout.ArrangeGrid(_panels, _width, _height, WorkspaceLayout.AutoColumns(_panels.Count));
            await SaveAsync();
        }

        RefreshHeight();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFocused(string id, int z)
    {
        if (_panels.FirstOrDefault(p => p.Id.ToString() == id) is { } panel)
        {
            _topZ = Math.Max(_topZ, z) + 1;
            panel.Z = z;
            await SaveAsync();
        }
    }

    [JSInvokable]
    public async Task OnGeometry(string id, double x, double y, double width, double height)
    {
        if (_panels.FirstOrDefault(p => p.Id.ToString() == id) is not { } panel)
        {
            return;
        }

        panel.X = x;
        panel.Y = y;
        panel.Width = width;
        panel.Height = height;
        _auto = false;
        RefreshHeight();
        await SaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task MeasureAsync()
    {
        double[] size = await _module!.InvokeAsync<double[]>("measure", _workspace);

        if (size.Length == 2)
        {
            _width = size[0];
            _height = size[1];
        }
    }

    private void RefreshHeight() => _contentHeight = WorkspaceLayout.ContentHeight(_panels, _height);

    private string PanelStyle(WorkspacePanel panel, bool solo) => solo
        ? $"z-index:{_topZ + 1}"
        : FormattableString.Invariant($"left:{panel.X:0}px;top:{panel.Y:0}px;width:{panel.Width:0}px;height:{panel.Height:0}px;z-index:{panel.Z}");

    private async Task AddAsync()
    {
        DialogParameters<AddChartDialog> parameters = new()
        {
            { x => x.Instruments, _instruments },
            { x => x.Used, _panels.Select(p => p.Symbol).ToHashSet() }
        };

        IDialogReference reference = await DialogService.ShowAsync<AddChartDialog>(string.Empty, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        DialogResult? result = await reference.Result;

        if (result is { Canceled: false, Data: string symbol })
        {
            WorkspacePanel panel = new() { Symbol = symbol, Z = ++_topZ };
            _soloId = null;

            if (_auto)
            {
                _panels.Add(panel);
                await MeasureAsync();
                WorkspaceLayout.ArrangeGrid(_panels, _width, _height, WorkspaceLayout.AutoColumns(_panels.Count));
            }
            else
            {
                WorkspaceLayout.PlaceNew(panel, _panels);
                _panels.Add(panel);
            }

            RefreshHeight();
            await SaveAsync();
        }
    }

    private async Task RemoveAsync(WorkspacePanel panel)
    {
        _panels.Remove(panel);

        if (_soloId == panel.Id)
        {
            _soloId = null;
        }

        if (_auto && _panels.Count > 0)
        {
            await MeasureAsync();
            WorkspaceLayout.ArrangeGrid(_panels, _width, _height, WorkspaceLayout.AutoColumns(_panels.Count));
        }

        RefreshHeight();
        await SaveAsync();
    }

    private async Task ToggleSyncAsync()
    {
        _sync = !_sync;

        try
        {
            await Store.SetAsync(SyncKey, _sync ? "1" : "0");
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task SaveLayoutAsync()
    {
        DialogParameters<PromptDialog> parameters = new() { { x => x.Title, "Guardar disposição" }, { x => x.Label, "Nome (por exemplo Day trading)" } };
        IDialogReference reference = await DialogService.ShowAsync<PromptDialog>(string.Empty, parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        DialogResult? result = await reference.Result;

        if (result is not { Canceled: false, Data: string name })
        {
            return;
        }

        string? error = await Api.SaveChartLayoutAsync(name, JsonSerializer.Serialize(new SavedWorkspace(_panels, _auto)), _cts.Token);

        if (error is null)
        {
            _layouts = await Api.GetChartLayoutsAsync(_cts.Token);
            Snackbar.Add($"Disposição «{name}» guardada na tua conta.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Warning);
        }
    }

    private async Task LoadLayoutAsync(ChartLayoutDto layout)
    {
        SavedWorkspace? saved;

        try
        {
            saved = JsonSerializer.Deserialize<SavedWorkspace>(layout.Json);
        }
        catch (JsonException)
        {
            saved = null;
        }

        if (saved is null)
        {
            Snackbar.Add("Esta disposição está danificada.", Severity.Warning);
            return;
        }

        HashSet<string> known = _instruments.Select(i => i.Symbol).ToHashSet();
        _panels = saved.Panels.Where(p => known.Contains(p.Symbol)).ToList();
        _panels.ForEach(WorkspaceLayout.Normalize);
        _auto = saved.Auto;
        _soloId = null;
        _topZ = _panels.Count == 0 ? 10 : _panels.Max(p => p.Z) + 1;
        RefreshHeight();
        await SaveAsync();
    }

    private async Task DeleteLayoutAsync(ChartLayoutDto layout)
    {
        if (await Api.DeleteChartLayoutAsync(layout.Name, _cts.Token))
        {
            _layouts = await Api.GetChartLayoutsAsync(_cts.Token);
        }
    }

    private async Task ClearAsync()
    {
        _panels.Clear();
        _soloId = null;
        _auto = true;
        RefreshHeight();
        await SaveAsync();
    }

    private async Task ArrangeAsync(int columns)
    {
        _soloId = null;
        await MeasureAsync();
        WorkspaceLayout.ArrangeGrid(_panels, _width, _height, columns);
        _auto = true;
        RefreshHeight();
        await SaveAsync();
    }

    private async Task CascadeAsync()
    {
        _soloId = null;
        WorkspaceLayout.ArrangeCascade(_panels);
        _auto = false;
        RefreshHeight();
        await SaveAsync();
    }

    private Task ToggleSoloTopAsync() =>
        _soloId is not null || _panels.Count == 0 ? SetSoloAsync(null) : SetSoloAsync(_panels.OrderByDescending(p => p.Z).First().Id);

    private Task ToggleSoloAsync(Guid id) => SetSoloAsync(_soloId == id ? null : id);

    private async Task SetSoloAsync(Guid? id)
    {
        _soloId = id;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdatePanelAsync(WorkspacePanel panel, string? symbol, int? timeframe)
    {
        panel.Symbol = symbol ?? panel.Symbol;
        panel.Timeframe = timeframe ?? panel.Timeframe;
        await SaveAsync();
    }

    private async Task<SavedWorkspace?> LoadSavedAsync()
    {
        try
        {
            string? json = await Store.GetAsync(StoreKey);
            return json is null ? null : JsonSerializer.Deserialize<SavedWorkspace>(json);
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException)
        {
            return null;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await Store.SetAsync(StoreKey, JsonSerializer.Serialize(new SavedWorkspace(_panels, _auto)));
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
        _cts.Dispose();
    }
}
