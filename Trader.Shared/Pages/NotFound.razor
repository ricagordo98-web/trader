@page "/not-found"
@layout MainLayout

<PageTitle>Não encontrado · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-6">
    <MudPaper Elevation="0" Outlined="true" Class="pa-6 text-center">
        <MudText Typo="Typo.h3" Class="mb-2">404</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-1">Página não encontrada</MudText>
        <MudText Typo="Typo.body2" Class="symbol-name mb-4">O endereço que abriste não existe nesta app.</MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Voltar às notícias</MudButton>
    </MudPaper>
</MudContainer>
