@page "/trading"
@inject TraderApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Trading · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
    <div class="d-flex align-center mb-4 gap-4">
        <MudText Typo="Typo.h4">Trading</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Pesquisar símbolo ou nome" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="trading-search" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="_loading" aria-label="Atualizar cotações" OnClick="LoadAsync" />
    </div>
    <MudText Typo="Typo.caption" Class="symbol-name d-block mb-3">
        Fonte das cotações: @PriceSources.Yahoo (atualizadas a cada ~2 minutos, com atraso possível). O gráfico ao vivo usa Finnhub nos EUA e no forex e a Binance na cripto. Passa o rato sobre um preço para ver a fonte; o preço da tua corretora pode diferir ligeiramente.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudPaper Elevation="0" Outlined="true">
        <MudTabs Rounded="true" TabPanelsClass="pa-0" ApplyEffectsToContainer="true">
            @foreach ((AssetClass? assetClass, string title) in _tabs)
            {
                <MudTabPanel Text="@(assetClass is null ? $"{title} ({Favorites.Count})" : title)">
                    <MudTable Items="Filter(assetClass)" Hover="true" OnRowClick="@((TableRowClickEventArgs<InstrumentQuote> args) => OpenChartAsync(args.Item))" RowStyle="cursor:pointer" Dense="true" Elevation="0" Loading="_loading" LoadingProgressColor="Color.Primary" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>Instrumento</MudTh>
                            <MudTh Style="text-align:right">Preço</MudTh>
                            <MudTh Style="text-align:right">Variação</MudTh>
                            <MudTh Style="text-align:right" Class="d-none d-sm-table-cell">1 mês</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <div class="d-flex align-center">
                                    <MudTooltip Text="@(IsFavorite(context.Symbol) ? "Remover dos favoritos" : "Adicionar aos favoritos")">
                                        <MudIconButton Icon="@(IsFavorite(context.Symbol) ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" Color="@(IsFavorite(context.Symbol) ? Color.Warning : Color.Default)" Size="Size.Small"
                                                       aria-label="@($"Favorito {context.Symbol}")" OnClick="@(() => ToggleFavoriteAsync(context.Symbol))" />
                                    </MudTooltip>
                                    <div>
                                <MudText Typo="Typo.subtitle2">@context.Symbol</MudText>
                                <MudText Typo="Typo.caption" Class="symbol-name">@context.Name</MudText>
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd Style="text-align:right;white-space:nowrap" title="@($"Fonte: {PriceSources.Yahoo}. {PriceSources.Describe(context.Symbol, context.AssetClass, CryptoBasis.Usd).Note}")">
                                @(context.Price is null ? "—" : $"{context.Price.Value.ToString("F" + PriceFormat.Decimals(context.AssetClass, context.Symbol, context.Price), _culture)} {context.Currency}")
                            </MudTd>
                            <MudTd Style="text-align:right">
                                @if (context.ChangePercent is { } pct)
                                {
                                    <MudText Typo="Typo.body2" Color="@(pct >= 0 ? Color.Success : Color.Error)">
                                        @(pct >= 0 ? "+" : string.Empty)@pct.ToString("F2", _culture)%
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                                }
                            </MudTd>
                            <MudTd Style="text-align:right" Class="d-none d-sm-table-cell"><Sparkline Values="context.Sparkline" /></MudTd>
                            <MudTd Style="text-align:right">
                                <MudTooltip Text="Porque se mexeu?">
                                    <MudIconButton Icon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" aria-label="@($"Porque se mexeu {context.Symbol}")" OnClick="@(() => OpenWhyAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            @if (_loading)
                            {
                                <div class="pa-4">
                                    @for (int i = 0; i < 6; i++)
                                    {
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
                                    }
                                </div>
                            }
                            else
                            {
                                <MudText Class="pa-4" Color="Color.Secondary">@(assetClass is null ? "Ainda sem favoritos. Toca na estrela de um ativo para o teres aqui, à mão." : "Sem instrumentos.")</MudText>
                            }
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    private static readonly System.Globalization.CultureInfo _culture = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");

    private readonly (AssetClass? AssetClass, string Title)[] _tabs =
    [
        (null, "Favoritos"),
        (AssetClass.Stock, "Ações"),
        (AssetClass.Commodity, "Mercadorias"),
        (AssetClass.Etf, "ETFs"),
        (AssetClass.Forex, "Forex"),
        (AssetClass.Crypto, "Cripto"),
        (AssetClass.Index, "Índices")
    ];

    private IReadOnlyList<InstrumentQuote> _quotes = [];
    private UserPreferences _profile = UserPreferences.Default;

    private IReadOnlyList<string> Favorites => _profile.Favorites ?? [];

    private bool IsFavorite(string symbol) => Favorites.Contains(symbol, StringComparer.OrdinalIgnoreCase);

    private async Task ToggleFavoriteAsync(string symbol)
    {
        List<string> next = Favorites.Where(f => !f.Equals(symbol, StringComparison.OrdinalIgnoreCase)).ToList();

        if (!IsFavorite(symbol))
        {
            next.Add(symbol);
        }

        UserPreferences updated = _profile with { Favorites = next };
        string? error = await Api.SaveProfileAsync(updated);

        if (error is null)
        {
            _profile = updated;
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }
    private string _search = string.Empty;
    private string? _error;
    private bool _loading;

    [SupplyParameterFromQuery] public string? Symbol { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        await OpenRequestedChartAsync();
    }

    private string? _handledSymbol;

    protected override Task OnParametersSetAsync() => Symbol != _handledSymbol && _quotes.Count > 0 ? OpenRequestedChartAsync() : Task.CompletedTask;

    private async Task OpenRequestedChartAsync()
    {
        _handledSymbol = Symbol;

        if (!string.IsNullOrWhiteSpace(Symbol) && _quotes.FirstOrDefault(q => q.Symbol.Equals(Symbol, StringComparison.OrdinalIgnoreCase)) is { } quote)
        {
            await OpenChartAsync(quote);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _quotes = await Api.GetInstrumentsAsync();
            _profile = await Api.GetProfileAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível obter os dados de mercado. Verifica se o servidor está a correr.";
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<InstrumentQuote> Filter(AssetClass? assetClass) =>
        _quotes.Where(q => (assetClass is null ? IsFavorite(q.Symbol) : q.AssetClass == assetClass)
            && (string.IsNullOrWhiteSpace(_search)
                || q.Symbol.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || q.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private async Task OpenChartAsync(InstrumentQuote? quote)
    {
        if (quote is null)
        {
            return;
        }

        DialogParameters<ChartDialog> parameters = new() { { x => x.Quote, quote } };
        DialogOptions options = new() { FullScreen = true, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ChartDialog>(quote.Symbol, parameters, options);
    }

    private Task OpenWhyAsync(InstrumentQuote quote) => WhyDialogLauncher.ShowAsync(DialogService, quote.Symbol, quote.Name);

}
