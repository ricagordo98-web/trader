@page "/prediction"
@using System.Globalization
@using Trader.Core.Intraday
@implements IDisposable
@inject TraderApiClient Api
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Predição · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
    <div class="d-flex align-center flex-wrap gap-3 mb-1">
        <MudText Typo="Typo.h4">Predição</MudText>
        <MudSpacer />
        <MudToggleGroup T="string" Value="_horizonKey" ValueChanged="OnHorizonChangedAsync" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary">
            <MudToggleItem Value="@HorizonAll" Text="Todas" />
            <MudToggleItem Value="@HorizonIntraday" Text="Intraday" />
            <MudToggleItem Value="@HorizonSwing" Text="Swing" />
        </MudToggleGroup>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_refreshing" OnClick="RefreshAsync">
            @(_refreshing ? "A calcular…" : "Recalcular agora")
        </MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="symbol-name mb-4">
        Sugestões geradas a partir de notícias, sentimento e indicadores técnicos. Ferramenta de apoio à decisão — não constitui aconselhamento financeiro.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_focus is { } focus)
    {
        <MudAlert Severity="@(focus.Status == SuggestionStatus.Open ? Severity.Info : focus.Status == SuggestionStatus.HitTakeProfit ? Severity.Success : focus.Status == SuggestionStatus.HitStopLoss ? Severity.Error : Severity.Normal)" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _focus = null)">
            Sugestão do alerta: @(focus.Direction == TradeDirection.Buy ? "COMPRAR" : "VENDER") @focus.Symbol · @StatusLabel(focus.Status)@(focus.RMultiple is { } r ? $" ({r.ToString("+0.00;-0.00", CultureInfo.InvariantCulture)} R)" : string.Empty)
            @if (focus.Status != SuggestionStatus.Open)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Class="ml-2" OnClick="@(() => OpenChartAsync(focus))">Ver gráfico</MudButton>
            }
        </MudAlert>
    }

    <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="@($"Sugestões ({_open.Count})")">
            @if (_loading)
            {
                <MudGrid Spacing="4">
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudItem xs="12" lg="6" xl="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" /></MudItem>
                    }
                </MudGrid>
            }
            else if (_open.Count == 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Sem sugestões neste momento</MudText>
                    <MudText Color="Color.Secondary">
                        Só aparecem sugestões quando vários sinais concordam com pelo menos @ThresholdPercent% de certeza e o ganho potencial é, no mínimo, 1,5× o risco.
                        As de swing recalculam-se a cada 15 minutos; as intraday a cada 90 segundos, apenas com o mercado aberto e volume acima do normal.
                    </MudText>
                </MudPaper>
            }

            <MudGrid Spacing="4">
                @foreach (SuggestionDto suggestion in _open)
                {
                    bool buy = suggestion.Direction == TradeDirection.Buy;
                    <MudItem xs="12" lg="6" xl="4" @key="suggestion.Id">
                        <MudPaper Elevation="0" Outlined="true" Class="@($"pa-4 h-100 suggestion-card{(suggestion.Id == Suggestion ? " focus-card" : string.Empty)}")" id="@($"suggestion-{suggestion.Id}")">
                            <div class="d-flex align-center gap-3">
                                <div class="text-center">
                                    <ConfidenceGauge Value="suggestion.Confidence" />
                                    @if (suggestion.CalibratedConfidence is { } calibrated)
                                    {
                                        <MudTooltip Text="@($"Acerto histórico de sugestões com esta certeza do modelo ({suggestion.CalibrationSamples} sugestões fechadas). Calculado a partir do track record.")">
                                            <MudText Typo="Typo.caption" Class="symbol-name">histórico ~@((calibrated * 100).ToString("0", CultureInfo.InvariantCulture))%</MudText>
                                        </MudTooltip>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-center gap-2 flex-wrap">
                                        <MudText Typo="Typo.h6">@suggestion.Symbol</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(buy ? Color.Success : Color.Error)" Class="ma-0">@(buy ? "COMPRAR" : "VENDER")</MudChip>
                                        @if (suggestion.Horizon == SuggestionHorizon.Intraday)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="ma-0">INTRADAY</MudChip>
                                        }
                                        @if (_earnings.TryGetValue(suggestion.Symbol, out DateOnly earningsDate))
                                        {
                                            <MudTooltip Text="Os resultados costumam provocar grandes saltos de preço. Pondera esperar.">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="ma-0">@EarningsLabel(earningsDate)</MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                    <MudText Typo="Typo.body2" Class="symbol-name">@suggestion.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="symbol-name">
                                        @TimeAgo(suggestion.CreatedAt) · expira em @ExpiresIn(suggestion.ExpiresAt)
                                    </MudText>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <div class="level-box flex-grow-1">
                                    <div class="level-label">Entrada</div>
                                    <div class="level-value">@Price(suggestion.Entry)</div>
                                    @if (_quotes.TryGetValue(suggestion.Symbol, out InstrumentQuote? quote) && quote.Price is { } current)
                                    {
                                        <MudText Typo="Typo.caption" Class="symbol-name">agora @Price(current)</MudText>
                                    }
                                </div>
                                <div class="level-box flex-grow-1">
                                    <div class="level-label">Stop loss</div>
                                    <div class="level-value" style="color:var(--mud-palette-error)">@Price(suggestion.StopLoss)</div>
                                    <MudText Typo="Typo.caption" Class="symbol-name">@Distance(suggestion.Entry, suggestion.StopLoss)</MudText>
                                </div>
                                <div class="level-box flex-grow-1">
                                    <div class="level-label">Take profit</div>
                                    <div class="level-value" style="color:var(--mud-palette-success)">@Price(suggestion.TakeProfit)</div>
                                    <MudText Typo="Typo.caption" Class="symbol-name">@Distance(suggestion.Entry, suggestion.TakeProfit)</MudText>
                                </div>
                                <div class="level-box">
                                    <div class="level-label">R:R</div>
                                    <div class="level-value">1 : @suggestion.RiskReward.ToString("0.0", CultureInfo.InvariantCulture)</div>
                                </div>
                            </div>

                            <MudText Typo="Typo.body2" Class="mt-3">@suggestion.Explanation</MudText>

                            <MudExpansionPanels Class="mt-3" Elevation="0" Outlined="true">
                                <MudExpansionPanel Text="Provas">
                                    @foreach (SignalResult signal in suggestion.Signals)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex align-center">
                                                <MudText Typo="Typo.body2"><GlossaryTerm Key="@Glossary.KeyForSignal(signal.Name)">@signal.Label</GlossaryTerm></MudText>
                                                <MudSpacer />
                                                <MudText Typo="Typo.caption" Color="@SignalColor(signal.Value, suggestion.Direction)">
                                                    @(signal.Value >= 0 ? "+" : string.Empty)@signal.Value.ToString("0.00", CultureInfo.InvariantCulture)
                                                </MudText>
                                            </div>
                                            <div class="signal-bar">
                                                <div class="signal-bar-mid"></div>
                                                <div class="signal-bar-fill @(signal.Value >= 0 ? "positive" : "negative")" style="width:@(Math.Min(Math.Abs(signal.Value), 1) * 50)%"></div>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="symbol-name">@signal.Detail</MudText>
                                        </div>
                                    }

                                    @if (suggestion.Articles.Count > 0)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Notícias e posts que sustentam a sugestão</MudText>
                                        @foreach (EvidenceArticle article in suggestion.Articles)
                                        {
                                            <div class="mb-2">
                                                @if (SafeUrl(article.Url) is { } url)
                                                {
                                                    <a href="@url" target="_blank" rel="noopener noreferrer" class="news-title" style="font-size:.9rem">@article.Title</a>
                                                }
                                                else
                                                {
                                                    <span class="news-title" style="font-size:.9rem">@article.Title</span>
                                                }
                                                <MudText Typo="Typo.caption" Class="symbol-name">
                                                    @article.Source · @TimeAgo(article.PublishedAt) · sentimento @(article.Sentiment >= 0 ? "+" : string.Empty)@article.Sentiment.ToString("0.00", CultureInfo.InvariantCulture)
                                                </MudText>
                                            </div>
                                        }
                                    }
                                </MudExpansionPanel>
                            </MudExpansionPanels>

                            <div class="d-flex justify-end mt-3">
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.School" OnClick="@(() => HowToReadAsync(suggestion))">Como ler</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Calculate" Href="@JournalLink(suggestion)">Calcular posição</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.CandlestickChart" OnClick="@(() => OpenChartAsync(suggestion))">Ver gráfico</MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="@($"Radar ({_radar.Events.Count})")">
            <div class="d-flex align-center flex-wrap gap-3 mb-3">
                <MudText Typo="Typo.body2" Class="symbol-name">
                    @RadarStatus()
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Radar" Disabled="_scanning" OnClick="ScanRadarAsync">
                    @(_scanning ? "A analisar…" : "Analisar agora")
                </MudButton>
            </div>

            <MudPaper Elevation="0" Outlined="true" Class="mb-4">
                <MudTable Items="_radar.Events" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm" T="RadarEvent" RowClass="cursor-pointer" OnRowClick="@(args => OpenChartAsync(args.Item.Symbol, args.Item.Name))">
                    <ToolBarContent>
                        <MudText Typo="Typo.subtitle1">Movimentos anormais detetados</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Quando</MudTh>
                        <MudTh>Ativo</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Direção</MudTh>
                        <MudTh>Força</MudTh>
                        <MudTh>Detalhe</MudTh>
                        <MudTh Style="text-align:right">Preço</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@TimeAgo(context.Time)</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">@context.Symbol</MudText>
                            <MudText Typo="Typo.caption" Class="symbol-name">@context.Name</MudText>
                        </MudTd>
                        <MudTd>@KindLabel(context.Kind)</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(context.Direction == TradeDirection.Buy ? Color.Success : Color.Error)" Class="ma-0">
                                @(context.Direction == TradeDirection.Buy ? "ALTA" : "BAIXA")
                            </MudChip>
                        </MudTd>
                        <MudTd>@((context.Strength * 100).ToString("0", CultureInfo.InvariantCulture))%</MudTd>
                        <MudTd>
                            @context.Detail
                            @if (context.Why is { Length: > 0 } why)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">@why</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:right">@Price(context.Price)</MudTd>
                        <MudTd Style="text-align:right">
                            <MudTooltip Text="Porque se mexeu?">
                                <MudIconButton Icon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" aria-label="@($"Porque se mexeu {context.Symbol}")" OnClick="@(() => WhyDialogLauncher.ShowAsync(DialogService, context.Symbol, context.Name))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4" Color="Color.Secondary">Sem movimentos anormais nas últimas 24 h. Aparecem aqui quando o volume dispara, há gaps ou o preço rompe níveis-chave com o mercado aberto.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>

            <MudGrid Spacing="4">
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="0" Outlined="true">
                        <MudTable Items="@TopByRelativeVolume()" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm" T="RadarRow" RowClass="cursor-pointer" OnRowClick="@(args => OpenChartAsync(args.Item.Symbol, args.Item.Name))">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1">Maior volume relativo</MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>Ativo</MudTh>
                                <MudTh Style="text-align:right">Preço</MudTh>
                                <MudTh Style="text-align:right">Var.</MudTh>
                                <MudTh Style="text-align:right">Volume</MudTh>
                                <MudTh Style="text-align:right">vs VWAP</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Symbol</MudTd>
                                <MudTd Style="text-align:right">@Price(context.Price)</MudTd>
                                <MudTd Style="text-align:right">@Percent(context.DayChangePercent)</MudTd>
                                <MudTd Style="text-align:right">@(context.RelativeVolume is { } rvol ? $"{rvol.ToString("0.0", CultureInfo.InvariantCulture)}×" : "—")</MudTd>
                                <MudTd Style="text-align:right">@Percent(context.VwapDistancePercent)</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4" Color="Color.Secondary">Sem dados de volume agora (mercados fechados ou histórico insuficiente).</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="0" Outlined="true">
                        <MudTable Items="@TopMovers()" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm" T="RadarRow" RowClass="cursor-pointer" OnRowClick="@(args => OpenChartAsync(args.Item.Symbol, args.Item.Name))">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1">Maiores variações do dia</MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>Ativo</MudTh>
                                <MudTh Style="text-align:right">Preço</MudTh>
                                <MudTh Style="text-align:right">Var.</MudTh>
                                <MudTh Style="text-align:right">Gap</MudTh>
                                <MudTh Style="text-align:right">Volume</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Symbol</MudTd>
                                <MudTd Style="text-align:right">@Price(context.Price)</MudTd>
                                <MudTd Style="text-align:right">@Percent(context.DayChangePercent)</MudTd>
                                <MudTd Style="text-align:right">@Percent(context.GapPercent)</MudTd>
                                <MudTd Style="text-align:right">@(context.RelativeVolume is { } rvol ? $"{rvol.ToString("0.0", CultureInfo.InvariantCulture)}×" : "—")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4" Color="Color.Secondary">Sem mercados abertos neste momento.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Track record">
            @if (_loading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
            }
            else if (_record is null || _record.ClosedCount == 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Ainda sem sugestões fechadas</MudText>
                    <MudText Color="Color.Secondary">
                        Cada sugestão é avaliada automaticamente contra o preço real e fecha quando toca no take profit, no stop loss ou ao fim do prazo (5 dias no swing, 3 horas no intraday).
                        Há @(_record?.OpenCount ?? 0) em curso; as estatísticas aparecem aqui à medida que fecharem.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="3" Class="mb-4">
                    @foreach ((string label, string value, Color color) in Kpis())
                    {
                        <MudItem xs="6" md="4" lg="2">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.caption" Class="symbol-name">@label</MudText>
                                <MudText Typo="Typo.h5" Color="color">@value</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">R acumulado</MudText>
                    <CumulativeCurve Points="@_record.Curve.Select(c => c.CumulativeR).ToList()" />
                </MudPaper>

                <MudGrid Spacing="4">
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-1">Acerto por sinal</MudText>
                            <MudText Typo="Typo.caption" Class="symbol-name mb-2">Com 20 ou mais sugestões, o sinal que está muito acima ou abaixo da média sugere aumentar ou reduzir o seu peso (Configurações → Scoring).</MudText>
                            @foreach (AccuracyStat stat in _record.BySignal)
                            {
                                <div class="d-flex align-center py-1">
                                    <MudText Typo="Typo.body2">@stat.Label</MudText>
                                    <MudText Typo="Typo.caption" Class="symbol-name ml-2">@stat.Count</MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.caption" Class="symbol-name mr-3">@SignalHint(stat)</MudText>
                                    <MudText Typo="Typo.caption" Class="symbol-name mr-3">@stat.AverageR.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture) R</MudText>
                                    <MudText Typo="Typo.body2">@((stat.WinRate * 100).ToString("0", CultureInfo.InvariantCulture))%</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                    @if (_record.Calibration.Count > 0)
                    {
                        <MudItem xs="12">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Class="mb-1">A certeza corresponde ao acerto real?</MudText>
                                <MudText Typo="Typo.caption" Class="symbol-name mb-2">Se uma sugestão diz 70% de certeza, cerca de 70% das sugestões dessa faixa deviam terminar com lucro.</MudText>
                                <MudSimpleTable Dense="true" Elevation="0">
                                    <thead>
                                        <tr><th>Certeza indicada</th><th>Sugestões</th><th>Certeza média</th><th>Acerto real</th><th>R médio</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (CalibrationBucket bucket in _record.Calibration)
                                        {
                                            <tr>
                                                <td>@bucket.Label</td>
                                                <td>@bucket.Count</td>
                                                <td>@((bucket.AverageConfidence * 100).ToString("0", CultureInfo.InvariantCulture))%</td>
                                                <td>@((bucket.WinRate * 100).ToString("0", CultureInfo.InvariantCulture))%</td>
                                                <td>@bucket.AverageR.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)</td>
                                                <td>@CalibrationVerdict(bucket)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>
                    }
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Acerto por fonte</MudText>
                            @foreach (AccuracyStat stat in _record.BySource.Take(12))
                            {
                                <div class="d-flex align-center py-1">
                                    <MudText Typo="Typo.body2">@stat.Label</MudText>
                                    <MudText Typo="Typo.caption" Class="symbol-name ml-2">@stat.Count</MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.body2">@((stat.WinRate * 100).ToString("0", CultureInfo.InvariantCulture))%</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudPaper Elevation="0" Outlined="true" Class="mt-4">
                    <MudTable Items="_closed" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Ativo</MudTh>
                            <MudTh>Direção</MudTh>
                            <MudTh>Resultado</MudTh>
                            <MudTh Style="text-align:right">R</MudTh>
                            <MudTh>Fechada</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Symbol</MudTd>
                            <MudTd>@(context.Direction == TradeDirection.Buy ? "Compra" : "Venda")</MudTd>
                            <MudTd>@StatusLabel(context.Status)</MudTd>
                            <MudTd Style="text-align:right">
                                <MudText Typo="Typo.body2" Color="@(context.RMultiple >= 0 ? Color.Success : Color.Error)">
                                    @(context.RMultiple >= 0 ? "+" : string.Empty)@context.RMultiple?.ToString("0.00", CultureInfo.InvariantCulture)
                                </MudText>
                            </MudTd>
                            <MudTd>@(context.ClosedAt is { } closed ? TimeAgo(closed) : "—")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>
        <MudTabPanel Text="Backtest">
            <MudToggleGroup T="string" @bind-Value="_backtestKind" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary" Class="mb-4">
                <MudToggleItem Value="@("swing")" Text="Swing (diário)" />
                <MudToggleItem Value="@("intraday")" Text="Intraday (5 min)" />
            </MudToggleGroup>

            @if (_backtestKind == "intraday")
            {
                <IntradayBacktestPanel />
            }
            else
            {
                <BacktestPanel />
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private const double ConfidenceThreshold = 0.6;
    private const string HorizonAll = "all";
    private const string HorizonIntraday = "intraday";
    private const string HorizonSwing = "swing";
    private static readonly TimeSpan RadarPollInterval = TimeSpan.FromSeconds(30);

    private readonly CancellationTokenSource _cts = new();
    private string _horizonKey = HorizonAll;
    private RadarSnapshot _radar = new(DateTimeOffset.MinValue, 0, [], []);
    private bool _scanning;
    private IReadOnlyList<SuggestionDto> _open = [];
    private Dictionary<string, DateOnly> _earnings = [];
    private IReadOnlyList<SuggestionDto> _closed = [];
    private Dictionary<string, InstrumentQuote> _quotes = [];
    private TrackRecordDto? _record;
    private string? _error;
    private bool _loading = true;
    private bool _refreshing;
    private int _tab;
    private string _backtestKind = "swing";
    private SuggestionDto? _focus;
    private bool _focusScrolled;

    [SupplyParameterFromQuery] public long? Suggestion { get; set; }

    [SupplyParameterFromQuery] public string? Tab { get; set; }

    private static int ThresholdPercent => (int)(ConfidenceThreshold * 100);

    private SuggestionHorizon? Horizon => _horizonKey switch
    {
        HorizonIntraday => SuggestionHorizon.Intraday,
        HorizonSwing => SuggestionHorizon.Swing,
        _ => null
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focus is { Status: SuggestionStatus.Open } focus && !_loading && !_focusScrolled && _tab == 0)
        {
            _focusScrolled = true;
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Trader.Shared/js/nav.js");
            await module.InvokeVoidAsync("scrollToSelector", $"#suggestion-{focus.Id}");
        }
    }

    private long? _handledSuggestion;
    private string? _handledTab;
    private bool _deepLinkReady;

    protected override async Task OnParametersSetAsync()
    {
        if (_deepLinkReady && (Suggestion != _handledSuggestion || Tab != _handledTab))
        {
            _focusScrolled = false;
            await ApplyDeepLinkAsync();
        }
    }

    private async Task ApplyDeepLinkAsync()
    {
        _handledSuggestion = Suggestion;
        _handledTab = Tab;
        _deepLinkReady = true;

        if (string.Equals(Tab, "radar", StringComparison.OrdinalIgnoreCase))
        {
            _tab = 1;
        }

        if (Suggestion is not { } id)
        {
            return;
        }

        _focus = _open.Concat(_closed).FirstOrDefault(s => s.Id == id);

        if (_focus is null)
        {
            await LoadAsync();
            _focus = _open.Concat(_closed).FirstOrDefault(s => s.Id == id);
        }

        _tab = _focus is null ? 0 : _focus.Status == SuggestionStatus.Open ? 0 : 2;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ApplyDeepLinkAsync();
        _ = PollRadarAsync();
    }

    private async Task OnHorizonChangedAsync(string? key)
    {
        _horizonKey = key ?? HorizonAll;
        _loading = true;
        await LoadAsync();
    }

    private async Task PollRadarAsync()
    {
        try
        {
            using PeriodicTimer timer = new(RadarPollInterval);

            do
            {
                try
                {
                    _radar = await Api.GetRadarAsync(_cts.Token);
                    await InvokeAsync(StateHasChanged);
                }
                catch (HttpRequestException)
                {
                }
            }
            while (await timer.WaitForNextTickAsync(_cts.Token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ScanRadarAsync()
    {
        _scanning = true;

        try
        {
            _radar = await Api.ScanRadarAsync(_cts.Token);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível analisar o mercado agora.";
        }
        finally
        {
            _scanning = false;
        }
    }

    private async Task LoadAsync()
    {
        _error = null;

        try
        {
            _open = await Api.GetSuggestionsAsync(null, true, 100, _cts.Token, Horizon);
            _closed = await Api.GetSuggestionsAsync(null, false, 200, _cts.Token, Horizon);
            _record = await Api.GetTrackRecordAsync(_cts.Token, Horizon);
            _quotes = (await Api.GetInstrumentsAsync(_cts.Token)).ToDictionary(q => q.Symbol);
            _earnings = (await Api.GetCalendarAsync(7, _cts.Token)).Events
                .Where(e => e is { Kind: CalendarKind.Earnings, Symbol: not null })
                .GroupBy(e => e.Symbol!)
                .ToDictionary(g => g.Key, g => g.Min(e => e.Date));
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível obter as sugestões. Verifica se o servidor está a correr.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;

        try
        {
            await Api.RefreshSuggestionsAsync(_cts.Token);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível recalcular agora.";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private Task HowToReadAsync(SuggestionDto suggestion) =>
        DialogService.ShowAsync<HowToReadDialog>(string.Empty, new DialogParameters<HowToReadDialog> { { x => x.Suggestion, suggestion } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true });

    private Task OpenChartAsync(SuggestionDto suggestion) => OpenChartAsync(suggestion.Symbol, suggestion.Name);

    private async Task OpenChartAsync(string symbol, string name)
    {
        InstrumentQuote quote = _quotes.TryGetValue(symbol, out InstrumentQuote? known)
            ? known
            : new InstrumentQuote(symbol, name, AssetClass.Stock, "USD", null, null, null, []);

        DialogParameters<ChartDialog> parameters = new() { { x => x.Quote, quote } };
        DialogOptions options = new() { FullScreen = true, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ChartDialog>(symbol, parameters, options);
    }

    private IEnumerable<RadarRow> TopByRelativeVolume() =>
        _radar.Board.Where(r => r.RelativeVolume is not null).OrderByDescending(r => r.RelativeVolume).Take(15);

    private IEnumerable<RadarRow> TopMovers() =>
        _radar.Board.Where(r => r.DayChangePercent is not null).OrderByDescending(r => Math.Abs(r.DayChangePercent!.Value)).Take(15);

    private string RadarStatus() => _radar.UpdatedAt == DateTimeOffset.MinValue
        ? "A aguardar a primeira análise (arranca ~1 minuto depois do servidor)."
        : $"Atualizado {TimeAgo(_radar.UpdatedAt)} · {_radar.Board.Count} de {_radar.ScannedCount} instrumentos com mercado aberto. Atualiza sozinho a cada 30 s; o servidor analisa de 90 em 90 s.";

    private static string Percent(double? value) =>
        value is { } v ? $"{v:+0.00;-0.00;0.00}%".Replace('.', ',') : "—";

    private static string KindLabel(RadarEventKind kind) => kind switch
    {
        RadarEventKind.VolumeSpike => "Pico de volume",
        RadarEventKind.Gap => "Gap de abertura",
        RadarEventKind.OpeningRangeBreakout => "Rompimento dos 30 min iniciais",
        RadarEventKind.PreviousDayBreakout => "Rompimento do dia anterior",
        _ => "Movimento brusco"
    };

    private IEnumerable<(string Label, string Value, Color Color)> Kpis()
    {
        TrackRecordDto record = _record!;

        yield return ("Fechadas", record.ClosedCount.ToString(CultureInfo.InvariantCulture), Color.Default);
        yield return ("Taxa de acerto", $"{record.WinRate * 100:0}%", record.WinRate >= 0.5 ? Color.Success : Color.Warning);
        yield return ("R médio", record.AverageR.ToString("+0.00;-0.00", CultureInfo.InvariantCulture), record.AverageR >= 0 ? Color.Success : Color.Error);
        yield return ("R total", record.TotalR.ToString("+0.0;-0.0", CultureInfo.InvariantCulture), record.TotalR >= 0 ? Color.Success : Color.Error);
        yield return ("Profit factor", record.ProfitFactor?.ToString("0.00", CultureInfo.InvariantCulture) ?? "—", record.ProfitFactor >= 1 ? Color.Success : Color.Warning);
        yield return ("Em curso", record.OpenCount.ToString(CultureInfo.InvariantCulture), Color.Default);
    }

    private static string JournalLink(SuggestionDto s) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"/journal?symbol={Uri.EscapeDataString(s.Symbol)}&entry={s.Entry / s.DisplayFactor:R}&sl={s.StopLoss / s.DisplayFactor:R}&tp={s.TakeProfit / s.DisplayFactor:R}&suggestion={s.Id}");

    private static string Price(double value) =>
        value.ToString(value >= 100 ? "N2" : value >= 1 ? "N3" : "N5", CultureInfo.GetCultureInfo("pt-PT"));

    private static string Distance(double entry, double level) =>
        $"{(level - entry) / entry * 100:+0.0;-0.0}%".Replace('.', ',');

    private static Color SignalColor(double value, TradeDirection direction) =>
        Math.Abs(value) < 0.1 ? Color.Default : (value > 0) == (direction == TradeDirection.Buy) ? Color.Success : Color.Warning;

    private static string EarningsLabel(DateOnly date)
    {
        int days = date.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;

        return days switch
        {
            <= 0 => "Resultados hoje",
            1 => "Resultados amanhã",
            _ => $"Resultados em {days} dias"
        };
    }

    private string SignalHint(AccuracyStat stat) =>
        stat.Count < 20 || _record is null ? "amostra curta" : Hint(stat.WinRate - _record.WinRate);

    private static string Hint(double difference) => difference switch
    {
        >= 0.10 => "↑ aumentar peso",
        <= -0.10 => "↓ reduzir peso",
        _ => "manter"
    };

    private static string CalibrationVerdict(CalibrationBucket bucket) => bucket.Count < 10
        ? "amostra curta"
        : bucket.WinRate + 0.10 < bucket.AverageConfidence ? "sobre-confiante"
        : bucket.WinRate - 0.10 > bucket.AverageConfidence ? "conservadora"
        : "calibrada";

    private static string StatusLabel(SuggestionStatus status) => status switch
    {
        SuggestionStatus.HitTakeProfit => "Take profit",
        SuggestionStatus.HitStopLoss => "Stop loss",
        SuggestionStatus.Expired => "Expirou",
        _ => "Aberta"
    };

    private static string? SafeUrl(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out Uri? uri) && uri.Scheme is "http" or "https" ? uri.ToString() : null;

    private static string TimeAgo(DateTimeOffset time)
    {
        TimeSpan elapsed = DateTimeOffset.UtcNow - time;

        return elapsed.TotalMinutes < 1 ? "agora"
            : elapsed.TotalMinutes < 60 ? $"há {(int)elapsed.TotalMinutes} min"
            : elapsed.TotalHours < 24 ? $"há {(int)elapsed.TotalHours} h"
            : $"há {(int)elapsed.TotalDays} d";
    }

    private static string ExpiresIn(DateTimeOffset time)
    {
        TimeSpan remaining = time - DateTimeOffset.UtcNow;

        return remaining.TotalHours < 1 ? "menos de 1 h"
            : remaining.TotalHours < 48 ? $"{(int)remaining.TotalHours} h"
            : $"{(int)remaining.TotalDays} d";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
