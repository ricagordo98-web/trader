@page "/settings"
@using Trader.Core.Abstractions
@using System.Globalization
@implements IDisposable
@inject TraderApiClient Api
@inject AuthSession Session
@inject ThemeState Theme
@inject IClientStore Store
@inject IServerEndpointSettings ServerEndpoint
@inject ISnackbar Snackbar

<PageTitle>Configurações · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-4">Configurações</MudText>

    <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="Aparência">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Tema</MudText>
                <MudRadioGroup T="ThemeMode" Value="Theme.Mode" ValueChanged="SetModeAsync">
                    <MudRadio Value="ThemeMode.Dark" Color="Color.Primary">Escuro</MudRadio>
                    <MudRadio Value="ThemeMode.Light" Color="Color.Primary">Claro</MudRadio>
                    <MudRadio Value="ThemeMode.System" Color="Color.Primary">Seguir o sistema</MudRadio>
                </MudRadioGroup>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Fonte dos preços</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Cotações e histórico: Yahoo Finance. Ao vivo: trades dos EUA e forex (OANDA) via Finnhub, e cripto via Binance. Futuros, índices e ações europeias só têm a cotação do Yahoo, com atraso possível.
                </MudText>
                <MudText Typo="Typo.subtitle2" Class="mb-1">Preço ao vivo da cripto</MudText>
                <MudRadioGroup T="string" Value="_cryptoBasis" ValueChanged="SetCryptoBasisAsync">
                    <MudRadio Value="@CryptoBasis.Usd" Color="Color.Primary">Alinhado ao USD do Yahoo (recomendado)</MudRadio>
                    <MudRadio Value="@CryptoBasis.Exchange" Color="Color.Primary">Preço da Binance em USDT (sem ajuste)</MudRadio>
                </MudRadioGroup>
                <MudText Typo="Typo.caption" Class="symbol-name mt-2">
                    O Bitcoin não tem um preço único: cada bolsa tem o seu, e o USDT costuma valer cerca de 0,1% acima do dólar. O ajuste mantém o gráfico ao segundo mas no mesmo nível do preço em USD. Compara sempre com o preço da tua corretora, que é o que conta para a execução.
                </MudText>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Cor de destaque</MudText>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (AccentOption accent in ThemeState.Accents)
                    {
                        <button type="button" class="accent-swatch @(accent == Theme.Accent ? "selected" : string.Empty)" title="@accent.Label"
                                style="background:@(Theme.IsDark ? accent.Dark : accent.Light)" @onclick="@(() => Theme.SetAccentAsync(Store, accent))"></button>
                    }
                </div>
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Perfil">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">A tua corretora</MudText>
                <MudSelect T="string" Label="Corretora" Variant="Variant.Outlined" Margin="Margin.Dense" Value="_profile.Broker" ValueChanged="SetBrokerAsync">
                    @foreach (BrokerOption option in BrokerCatalog.Options)
                    {
                        <MudSelectItem Value="@option.Key">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="symbol-name mt-2">
                    Usada nas notas de fonte dos preços e como plataforma por omissão na carteira. A Trading 212 só disponibiliza API para contas Invest e ISA, não para CFD, por isso a ligação automática à conta não está disponível.
                </MudText>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Moeda dos preços</MudText>
                <MudRadioGroup T="string" Value="_profile.DisplayCurrency ?? string.Empty" ValueChanged="SetProfileCurrencyAsync">
                    <MudRadio Value="@string.Empty" Color="Color.Primary">Moeda original de cada ativo</MudRadio>
                    <MudRadio Value="@("EUR")" Color="Color.Primary">Euro (EUR)</MudRadio>
                    <MudRadio Value="@("USD")" Color="Color.Primary">Dólar (USD)</MudRadio>
                </MudRadioGroup>
                <MudText Typo="Typo.caption" Class="symbol-name mt-2">
                    Converte cotações, gráficos, sugestões e radar com a taxa de câmbio atual (a mesma para todo o histórico do gráfico). Forex e índices não são convertidos. O diário, a calculadora e os alertas de preço continuam na moeda original do ativo.
                </MudText>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Classes de ativos que queres ver</MudText>
                <div class="d-flex flex-wrap gap-4">
                    @foreach ((AssetClass assetClass, string label) in ClassOptions)
                    {
                        <MudCheckBox T="bool" Label="@label" Color="Color.Primary" Value="@IsClassEnabled(assetClass)" ValueChanged="@((bool on) => ToggleClassAsync(assetClass, on))" />
                    }
                </div>
                <MudText Typo="Typo.caption" Class="symbol-name mt-1">
                    Filtra as cotações, sugestões e radar que vês. Os alertas enviados pelo servidor (incluindo o ntfy) continuam a cobrir tudo.
                </MudText>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Horário silencioso</MudText>
                <div class="d-flex align-center gap-3">
                    <MudNumericField T="int?" Label="Das (hora)" Min="0" Max="23" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Style="max-width:120px"
                                     Value="_profile.QuietFromHour" ValueChanged="@((int? hour) => SetQuietAsync(hour, _profile.QuietToHour))" />
                    <MudNumericField T="int?" Label="Até (hora)" Min="0" Max="23" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Style="max-width:120px"
                                     Value="_profile.QuietToHour" ValueChanged="@((int? hour) => SetQuietAsync(_profile.QuietFromHour, hour))" />
                    <MudButton Variant="Variant.Text" OnClick="@(() => SaveProfileAsync(_profile with { QuietFromHour = null, QuietToHour = null }))">Desativar</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="symbol-name mt-1">
                    Nestas horas (hora do servidor) os teus alertas continuam a registar-se na campainha, mas não enviam notificações para o telemóvel (ntfy). Só os stops atingidos passam sempre.
                </MudText>
                <div class="d-flex align-center gap-3 mt-3">
                    <MudTextField T="string" @bind-Value="_myTopic" Label="O meu tópico ntfy (opcional, só para ti)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="64" Style="max-width:380px" />
                    <MudButton Variant="Variant.Text" OnClick="@(() => SaveProfileAsync(_profile with { NtfyTopic = string.IsNullOrWhiteSpace(_myTopic) ? null : _myTopic.Trim() }))">Guardar</MudButton>
                </div>
                <MudSwitch T="bool" Value="_profile.PushMarketAlerts" ValueChanged="@((bool on) => SaveProfileAsync(_profile with { PushMarketAlerts = on }))" Color="Color.Primary" Class="mt-2"
                           Label="Enviar também novidades do mercado para o telemóvel" />
                <MudText Typo="Typo.caption" Class="symbol-name mt-1">
                    Se definires um tópico teu, os teus alertas (trades, regras, preços) vão para ele em vez do tópico partilhado. Na app ntfy do Android, subscreve-o e os botões de ação aparecem na notificação.
                </MudText>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Texto do "Porquê?"</MudText>
                <MudSwitch T="bool" Label="Usar o modelo local (Ollama) para escrever a explicação" Color="Color.Primary" Value="_profile.NarrativeEnabled" ValueChanged="SetNarrativeAsync" />
                <MudText Typo="Typo.caption" Class="symbol-name">
                    Desligado, a explicação usa só o resumo automático (mais rápido e sem carga na GPU). O texto do modelo é sempre verificado contra as fontes antes de aparecer.
                </MudText>
                @if (_profileError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_profileError</MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="Notificações">
            @if (_ntfyTopic is not null)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Notificações no telemóvel e no PC (ntfy)</MudText>
                    <MudText Typo="Typo.caption" Class="symbol-name mb-3">
                        Recebes sugestões novas e stops/alvos atingidos mesmo com a app fechada. Instala a app ntfy (grátis) e subscreve o mesmo tópico.
                        Quem souber o tópico lê os alertas, por isso usa um nome longo e difícil de adivinhar.
                    </MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_ntfyTopic" Label="Tópico (vazio = desligado)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="64" /></MudItem>
                        <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_ntfyServer" Label="Servidor" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12"><MudTextField T="string" @bind-Value="_ntfyPublicUrl" Label="Endereço público da app (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="https://trader.exemplo.com"
                                                       HelperText="Com este endereço, tocar na notificação abre a app no sítio certo (e aparece o botão Abrir no Trader). Tem de ser acessível a partir do telemóvel." /></MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="_ntfyPushMarket" Color="Color.Primary" Label="Enviar também novidades do mercado (sugestões, radar, calendário, resumo) para o tópico partilhado" />
                            <MudText Typo="Typo.caption" Class="symbol-name">Desligado por omissão: só chegam ao telemóvel os stops e alvos das tuas trades, os alertas de preço e as tuas regras.</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                @if (_ntfyError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_ntfyError</MudAlert>
                }
                <div class="d-flex gap-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveNtfyAsync">Guardar</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="TestNtfyAsync">Enviar notificação de teste</MudButton>
                </div>
            }
            else
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }

            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-4">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Alertas de preço</MudText>
                <MudText Typo="Typo.caption" Class="symbol-name mb-3">
                    Avisa-te quando um ativo cruza o preço que definires. Os stops e alvos das trades abertas na Carteira avisam automaticamente.
                </MudText>
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_alertSymbol" Label="Ativo" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (WatchlistItem item in _watchlist)
                            {
                                <MudSelectItem T="string" Value="@item.Symbol">@item.Symbol · @item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="PriceCondition" @bind-Value="_alertCondition" Label="Quando" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="PriceCondition" Value="PriceCondition.Above">Subir acima de</MudSelectItem>
                            <MudSelectItem T="PriceCondition" Value="PriceCondition.Below">Descer abaixo de</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="double" @bind-Value="_alertPrice" Label="Preço (moeda original do ativo)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_alertNote" Label="Nota (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                    </MudItem>
                </MudGrid>
                @if (_alertError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_alertError</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AddPriceAlertAsync" Class="mb-3">Adicionar alerta</MudButton>

                @if (_priceAlerts.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="symbol-name">Sem alertas de preço.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (PriceAlertDto alert in _priceAlerts)
                            {
                                <tr>
                                    <td><SymbolLabel Symbol="@alert.Symbol" /></td>
                                    <td>@(alert.Condition == PriceCondition.Above ? "acima de" : "abaixo de") @alert.Price.ToString("0.#####", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</td>
                                    <td>@alert.Note</td>
                                    <td>@(alert.TriggeredAt is { } at ? $"disparado {at.ToLocalTime():dd/MM HH:mm}" : "ativo")</td>
                                    <td style="text-align:right"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Apagar alerta {alert.Symbol}")" OnClick="@(() => DeletePriceAlertAsync(alert))" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-2">Regras de alerta</MudText>
            <AlertRulesPanel />
        </MudTabPanel>
        <MudTabPanel Text="Conta">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                <div class="d-flex align-center flex-wrap gap-3">
                    <div>
                        <MudText Typo="Typo.caption" Class="symbol-name">Sessão iniciada como</MudText>
                        <MudText Typo="Typo.subtitle1">@Session.Email</MudText>
                    </div>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout" OnClick="Session.LogoutAsync">Terminar sessão</MudButton>
                </div>
            </MudPaper>

            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Alterar palavra-passe</MudText>
                        <MudTextField T="string" @bind-Value="_oldPassword" Label="Palavra-passe atual" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true" />
                        <MudTextField T="string" @bind-Value="_newPassword" Label="Nova palavra-passe" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true"
                                      HelperText="Mínimo de 8 caracteres, com maiúscula, minúscula, número e símbolo." />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrEmpty(_oldPassword) || string.IsNullOrEmpty(_newPassword))" OnClick="ChangePasswordAsync">Guardar</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Criar novo utilizador</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name mb-3">Só quem tem sessão iniciada pode criar contas. Não existe registo público.</MudText>
                        <MudTextField T="string" @bind-Value="_userEmail" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true" />
                        <MudTextField T="string" @bind-Value="_userPassword" Label="Palavra-passe inicial" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_userEmail) || string.IsNullOrEmpty(_userPassword))" OnClick="CreateUserAsync">Criar conta</MudButton>
                    </MudPaper>
                </MudItem>

                @if (ServerEndpoint.IsConfigurable)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-1">Servidor</MudText>
                            <MudText Typo="Typo.caption" Class="symbol-name mb-3">Endereço do servidor Trader a que esta app se liga. A alteração aplica-se depois de reiniciares a app.</MudText>
                            <div class="d-flex flex-wrap gap-3 align-center">
                                <MudTextField T="string" @bind-Value="_serverUrl" Label="URL" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Immediate="true" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveServerUrl">Guardar</MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="Dados e sistema">
            <MudTabs Rounded="true" TabPanelsClass="pt-3">
                <MudTabPanel Text="Watchlist">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Adicionar instrumento</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name mb-3">Usa o símbolo do Yahoo Finance (ex.: AMD, GC=F para o ouro, EURUSD=X para forex). O símbolo é validado antes de ser guardado.</MudText>
                        <MudGrid Spacing="2" Class="align-center">
                            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newSymbol" Label="Símbolo" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" /></MudItem>
                            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newName" Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" /></MudItem>
                            <MudItem xs="6" sm="2">
                                <MudSelect T="AssetClass" @bind-Value="_newClass" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="AssetClass.Stock">Ação</MudSelectItem>
                                    <MudSelectItem Value="AssetClass.Commodity">Mercadoria</MudSelectItem>
                                    <MudSelectItem Value="AssetClass.Etf">ETF</MudSelectItem>
                                    <MudSelectItem Value="AssetClass.Forex">Forex</MudSelectItem>
                                    <MudSelectItem Value="AssetClass.Crypto">Cripto</MudSelectItem>
                                    <MudSelectItem Value="AssetClass.Index">Índice</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="1"><MudTextField T="string" @bind-Value="_newCurrency" Label="Moeda" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" /></MudItem>
                            <MudItem xs="12" sm="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newSymbol) || string.IsNullOrWhiteSpace(_newName))" OnClick="AddInstrumentAsync">Adicionar</MudButton>
                            </MudItem>
                        </MudGrid>
                        @if (_watchlistError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_watchlistError</MudAlert>
                        }
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true">
                        <MudTable Items="_watchlist" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Símbolo</MudTh>
                                <MudTh>Nome</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Moeda</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><SymbolLabel Symbol="@context.Symbol" /></MudTd>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>@ClassLabel(context.AssetClass)</MudTd>
                                <MudTd>@context.Currency</MudTd>
                                <MudTd Style="text-align:right">
                                    <MudTooltip Text="Remover da watchlist">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Disabled="_busy" aria-label="@($"Remover {context.Symbol}")" OnClick="@(() => RemoveInstrumentAsync(context))" />
                                    </MudTooltip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="Fontes">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Estado do sistema</MudText>
                        @foreach (HealthItem item in _health)
                        {
                            <div class="d-flex align-center mb-1">
                                <MudIcon Icon="@HealthIcon(item.Level)" Color="@HealthColor(item.Level)" Size="Size.Small" Class="mr-2" />
                                <MudText Typo="Typo.body2"><b>@item.Name</b> · @item.Detail</MudText>
                            </div>
                        }
                    </MudPaper>
                    <MudPaper Elevation="0" Outlined="true">
                        <MudTable Items="_sources" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Fonte</MudTh>
                                <MudTh>Estado</MudTh>
                                <MudTh>Intervalo</MudTh>
                                <MudTh>Última recolha</MudTh>
                                <MudTh Style="text-align:right">Obtidos / novos</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>
                                    @if (!context.Enabled)
                                    {
                                        <MudTooltip Text="@context.DisabledReason"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Desligada</MudChip></MudTooltip>
                                    }
                                    else if (context.LastError is not null)
                                    {
                                        <MudTooltip Text="@context.LastError"><MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Atenção</MudChip></MudTooltip>
                                    }
                                    else if (context.LastRun is null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">A aguardar</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Ativa</MudChip>
                                    }
                                </MudTd>
                                <MudTd>@(context.Enabled ? $"{context.IntervalMinutes} min" : "—")</MudTd>
                                <MudTd>@(context.LastRun is { } run ? run.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture) : "—")</MudTd>
                                <MudTd Style="text-align:right">@(context.LastRun is null ? "—" : $"{context.LastFetched} / {context.LastAdded}")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                    <MudText Typo="Typo.caption" Class="symbol-name mt-2">As chaves e credenciais das fontes configuram-se no servidor (ver README). Aqui só se mostra o estado.</MudText>
                </MudTabPanel>
                <MudTabPanel Text="Sistema">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Backups da base de dados</MudText>
                        <MudText Typo="Typo.caption" Class="symbol-name mb-3">
                            O servidor guarda uma cópia por dia (as últimas 14) na pasta backups, ao lado da base de dados. Para restaurar, para o servidor e substitui o trader.db por uma destas cópias.
                        </MudText>
                        @if (_backupError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_backupError</MudAlert>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="CreateBackupAsync" Class="mb-3">Fazer backup agora</MudButton>
                        @if (_backups.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="symbol-name">Ainda não há backups.</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    @foreach (BackupInfo backup in _backups)
                                    {
                                        <tr>
                                            <td>@backup.Name</td>
                                            <td>@backup.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td style="text-align:right">@((backup.SizeBytes / 1024.0 / 1024.0).ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))) MB</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </MudTabPanel>
                <MudTabPanel Text="Scoring">
                    @if (_scoring is not null)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-1">Pesos dos sinais</MudText>
                            <MudText Typo="Typo.caption" Class="symbol-name mb-3">Quanto cada sinal conta na pontuação. Alterações aplicam-se ao próximo cálculo (a cada 15 minutos ou em "Recalcular agora").</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.SentimentWeight" Label="Sentimento" Min="0" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.BuzzWeight" Label="Volume de menções" Min="0" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.TrendWeight" Label="Tendência" Min="0" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.MomentumWeight" Label="Momentum" Min="0" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.BollingerWeight" Label="Bollinger" Min="0" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                        </MudPaper>
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Critérios para emitir uma sugestão</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.ConfidenceThreshold" Label="Certeza mínima (0,5–0,95)" Min="0.5" Max="0.95" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="int" @bind-Value="_scoring.MinAgreeingSignals" Label="Sinais concordantes (mín.)" Min="2" Max="5" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.MinRiskReward" Label="R:R mínimo" Min="1" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.SlAtrMultiple" Label="Stop loss (× ATR)" Min="0.5" Max="5" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="double" @bind-Value="_scoring.TpAtrMultiple" Label="Take profit (× ATR)" Min="0.5" Max="10" Step="0.1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="4"><MudNumericField T="int" @bind-Value="_scoring.ExpiryDays" Label="Validade (dias)" Min="1" Max="30" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            </MudGrid>
                        </MudPaper>
                        @if (_scoringError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_scoringError</MudAlert>
                        }
                        <div class="d-flex gap-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveScoringAsync">Guardar</MudButton>
                            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="ResetScoringAsync">Repor valores por omissão</MudButton>
                        </div>
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                </MudTabPanel>
            </MudTabs>
        </MudTabPanel>
    </MudTabs>
    <MudText Typo="Typo.caption" Class="symbol-name mt-4"><MudLink Href="/about">Sobre a app, fontes e créditos</MudLink></MudText>
</MudContainer>

@code {
    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<WatchlistItem> _watchlist = [];
    private IReadOnlyList<SourceStatus> _sources = [];
    private IReadOnlyList<HealthItem> _health = [];

    private static string HealthIcon(HealthLevel level) => level switch
    {
        HealthLevel.Ok => Icons.Material.Filled.CheckCircle,
        HealthLevel.Warning => Icons.Material.Filled.Warning,
        HealthLevel.Down => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.RemoveCircleOutline
    };

    private static Color HealthColor(HealthLevel level) => level switch
    {
        HealthLevel.Ok => Color.Success,
        HealthLevel.Warning => Color.Warning,
        HealthLevel.Down => Color.Error,
        _ => Color.Default
    };
    private ScoringOptions? _scoring;
    private string? _ntfyTopic;
    private string _ntfyPublicUrl = string.Empty;
    private bool _ntfyPushMarket;
    private string _myTopic = string.Empty;
    private string _ntfyServer = NtfySettings.DefaultServer;
    private string? _ntfyError;
    private IReadOnlyList<PriceAlertDto> _priceAlerts = [];
    private string? _alertSymbol;
    private PriceCondition _alertCondition = PriceCondition.Above;
    private double _alertPrice;
    private string _alertNote = string.Empty;
    private string? _alertError;
    private IReadOnlyList<BackupInfo> _backups = [];
    private string? _backupError;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _userEmail = string.Empty;
    private string _userPassword = string.Empty;
    private string _serverUrl = string.Empty;
    private string _newSymbol = string.Empty;
    private string _newName = string.Empty;
    private string _newCurrency = "USD";
    private AssetClass _newClass = AssetClass.Stock;
    private string? _watchlistError;
    private string? _scoringError;
    private bool _busy;
    private int _tab;
    private string _cryptoBasis = CryptoBasis.Usd;
    private UserPreferences _profile = UserPreferences.Default;
    private string? _profileError;

    private static readonly (AssetClass, string)[] ClassOptions =
    [
        (AssetClass.Stock, "Ações"),
        (AssetClass.Etf, "ETFs"),
        (AssetClass.Commodity, "Mercadorias"),
        (AssetClass.Forex, "Forex"),
        (AssetClass.Crypto, "Cripto"),
        (AssetClass.Index, "Índices")
    ];

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;
        _serverUrl = ServerEndpoint.Url ?? string.Empty;

        try
        {
            _watchlist = await Api.GetWatchlistAsync(_cts.Token);
            _sources = await Api.GetSourcesAsync(_cts.Token);
            _health = await Api.GetHealthAsync(_cts.Token);
            _scoring = await Api.GetScoringAsync(_cts.Token);
            NtfySettings ntfy = await Api.GetNtfyAsync(_cts.Token);
            _ntfyTopic = ntfy.Topic;
            _ntfyServer = ntfy.Server;
            _ntfyPublicUrl = ntfy.PublicUrl;
            _ntfyPushMarket = ntfy.PushMarketAlerts;
            _backups = await Api.GetBackupsAsync(_cts.Token);
            _priceAlerts = await Api.GetPriceAlertsAsync(_cts.Token);
            _profile = await Api.GetProfileAsync(_cts.Token);
            _myTopic = _profile.NtfyTopic ?? string.Empty;
            _cryptoBasis = await Api.GetCryptoBasisAsync(_cts.Token);
            _alertSymbol = _watchlist.FirstOrDefault()?.Symbol;
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível carregar as configurações do servidor.", Severity.Error);
        }
    }

    private async Task SetCryptoBasisAsync(string? basis)
    {
        string? error = await Api.SetCryptoBasisAsync(basis ?? CryptoBasis.Usd, _cts.Token);

        if (error is null)
        {
            _cryptoBasis = basis ?? CryptoBasis.Usd;
            Snackbar.Add("Fonte do preço da cripto atualizada.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private Task SetQuietAsync(int? from, int? to) =>
        from is not null && to is not null ? SaveProfileAsync(_profile with { QuietFromHour = from, QuietToHour = to }) : Task.CompletedTask;

    private bool IsClassEnabled(AssetClass assetClass) => _profile.Allows(assetClass);

    private Task SetBrokerAsync(string? broker) => SaveProfileAsync(_profile with { Broker = broker ?? BrokerCatalog.Other });

    private Task SetProfileCurrencyAsync(string? currency) => SaveProfileAsync(_profile with { DisplayCurrency = currency ?? string.Empty });

    private Task SetNarrativeAsync(bool enabled) => SaveProfileAsync(_profile with { NarrativeEnabled = enabled });

    private Task ToggleClassAsync(AssetClass assetClass, bool enabled)
    {
        List<AssetClass> current = _profile.EnabledClasses.Count == 0 ? ClassOptions.Select(o => o.Item1).ToList() : _profile.EnabledClasses.ToList();

        if (enabled)
        {
            current.Add(assetClass);
        }
        else
        {
            current.Remove(assetClass);
        }

        List<AssetClass> distinct = current.Distinct().ToList();

        if (distinct.Count == 0)
        {
            Snackbar.Add("Tem de ficar pelo menos uma classe de ativos.", Severity.Warning);
            return Task.CompletedTask;
        }

        return SaveProfileAsync(_profile with { EnabledClasses = distinct.Count == ClassOptions.Length ? [] : distinct });
    }

    private async Task SaveProfileAsync(UserPreferences preferences)
    {
        _profileError = await Api.SaveProfileAsync(preferences, _cts.Token);

        if (_profileError is null)
        {
            _profile = preferences;
            Snackbar.Add("Perfil guardado. As páginas já abertas só mudam ao recarregar.", Severity.Success);
        }
    }

    private async Task CreateBackupAsync()
    {
        _busy = true;
        _backupError = await Api.CreateBackupAsync(_cts.Token);

        if (_backupError is null)
        {
            _backups = await Api.GetBackupsAsync(_cts.Token);
            Snackbar.Add("Backup criado.", Severity.Success);
        }

        _busy = false;
    }

    private async Task AddPriceAlertAsync()
    {
        _busy = true;
        _alertError = await Api.AddPriceAlertAsync(new CreatePriceAlertRequest(_alertSymbol ?? string.Empty, _alertCondition, _alertPrice, _alertNote), _cts.Token);

        if (_alertError is null)
        {
            _priceAlerts = await Api.GetPriceAlertsAsync(_cts.Token);
            _alertPrice = 0;
            _alertNote = string.Empty;
        }

        _busy = false;
    }

    private async Task DeletePriceAlertAsync(PriceAlertDto alert)
    {
        if (await Api.DeletePriceAlertAsync(alert.Id, _cts.Token))
        {
            _priceAlerts = await Api.GetPriceAlertsAsync(_cts.Token);
        }
    }

    private async Task SaveNtfyAsync()
    {
        _busy = true;
        _ntfyError = await Api.SaveNtfyAsync(new NtfySettings(_ntfyServer, _ntfyTopic ?? string.Empty, _ntfyPublicUrl, _ntfyPushMarket), _cts.Token);
        _busy = false;

        if (_ntfyError is null)
        {
            Snackbar.Add("Notificações guardadas.", Severity.Success);
        }
    }

    private async Task TestNtfyAsync()
    {
        await SaveNtfyAsync();

        if (_ntfyError is not null)
        {
            return;
        }

        _busy = true;
        _ntfyError = await Api.SendNtfyTestAsync(_cts.Token);
        _busy = false;

        if (_ntfyError is null)
        {
            Snackbar.Add("Notificação de teste enviada.", Severity.Success);
        }
    }

    private Task SetModeAsync(ThemeMode mode) => Theme.SetModeAsync(Store, mode, mode == ThemeMode.System);

    private async Task ChangePasswordAsync()
    {
        _busy = true;
        string? error = await Api.ChangePasswordAsync(_oldPassword, _newPassword);
        _busy = false;

        if (error is null)
        {
            _oldPassword = string.Empty;
            _newPassword = string.Empty;
            Snackbar.Add("Palavra-passe alterada.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private async Task CreateUserAsync()
    {
        _busy = true;
        string? error = await Api.CreateUserAsync(_userEmail.Trim(), _userPassword);
        _busy = false;

        if (error is null)
        {
            Snackbar.Add($"Conta criada para {_userEmail.Trim()}.", Severity.Success);
            _userEmail = string.Empty;
            _userPassword = string.Empty;
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private void SaveServerUrl()
    {
        if (!Uri.TryCreate(_serverUrl.Trim(), UriKind.Absolute, out Uri? uri) || uri.Scheme is not ("http" or "https"))
        {
            Snackbar.Add("Indica um URL válido (http:// ou https://).", Severity.Warning);
            return;
        }

        ServerEndpoint.Url = uri.ToString();
        Snackbar.Add("Guardado. Reinicia a app para ligar ao novo servidor.", Severity.Success);
    }

    private async Task AddInstrumentAsync()
    {
        _busy = true;
        _watchlistError = await Api.AddInstrumentAsync(new AddInstrumentRequest(_newSymbol, _newName, _newClass, _newCurrency));

        if (_watchlistError is null)
        {
            _watchlist = await Api.GetWatchlistAsync(_cts.Token);
            _newSymbol = string.Empty;
            _newName = string.Empty;
            Snackbar.Add("Instrumento adicionado.", Severity.Success);
        }

        _busy = false;
    }

    private async Task RemoveInstrumentAsync(WatchlistItem item)
    {
        _busy = true;

        if (await Api.RemoveInstrumentAsync(item.Symbol))
        {
            _watchlist = await Api.GetWatchlistAsync(_cts.Token);
            Snackbar.Add($"{item.Symbol} removido.", Severity.Info);
        }

        _busy = false;
    }

    private async Task SaveScoringAsync()
    {
        _busy = true;
        _scoringError = await Api.SaveScoringAsync(_scoring!);
        _busy = false;

        if (_scoringError is null)
        {
            Snackbar.Add("Pesos guardados.", Severity.Success);
        }
    }

    private async Task ResetScoringAsync()
    {
        _busy = true;
        await Api.ResetScoringAsync();
        _scoring = await Api.GetScoringAsync(_cts.Token);
        _scoringError = null;
        _busy = false;
        Snackbar.Add("Valores por omissão repostos.", Severity.Info);
    }

    private static string ClassLabel(AssetClass assetClass) => assetClass switch
    {
        AssetClass.Stock => "Ação",
        AssetClass.Commodity => "Mercadoria",
        AssetClass.Etf => "ETF",
        AssetClass.Crypto => "Cripto",
        AssetClass.Index => "Índice",
        _ => "Forex"
    };

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
