@page "/journal"
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client
@using Trader.Core.Alerts
@implements IDisposable
@inject TraderApiClient Api
@inject AuthSession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Carteira · Trader</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-1">Carteira</MudText>
    <MudText Typo="Typo.body2" Class="symbol-name mb-4">
        Calcula quanto arriscar em cada operação e regista as que fazes na corretora, para comparares o teu resultado com o das sugestões.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_risk?.Message is { } riskMessage)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">@riskMessage</MudAlert>
    }

    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" />
    }
    else
    {
        <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="Calculadora">
                <PositionCalculatorPanel Account="_account" Watchlist="_watchlist" Quotes="_quotes" OpenSuggestions="_openSuggestions"
                                         Initial="_prefill" Costs="_costs" OnRegister="OpenTradeDialogAsync" OnSaveAccount="SaveAccountAsync" />
            </MudTabPanel>

            <MudTabPanel Text="@($"Trades ({_trades.Count})")">
                <div class="d-flex align-center flex-wrap gap-3 mb-3">
                    @foreach ((TradeStatus? value, string label) in _filters)
                    {
                        <MudChip T="string" Variant="@(_filter == value ? Variant.Filled : Variant.Outlined)" Color="@(_filter == value ? Color.Primary : Color.Default)"
                                 OnClick="@(() => _filter = value)">@label</MudChip>
                    }
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportCsvAsync" Disabled="@(_trades.Count == 0)">Exportar CSV</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FileUpload" OnClick="ImportCsvAsync">Importar CSV</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenTradeDialogAsync(null))">Nova trade</MudButton>
                </div>

                @if (VisibleTrades.Count == 0)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">Sem trades</MudText>
                        <MudText Color="Color.Secondary">Regista aqui as operações que fazes na XTB, Trading 212 ou outra plataforma.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Elevation="0" Outlined="true">
                        <MudTable Items="VisibleTrades" Dense="true" Elevation="0" Hover="true" Breakpoint="Breakpoint.Md" RowClassFunc="TradeRowClass">
                            <HeaderContent>
                                <MudTh>Ativo</MudTh>
                                <MudTh>Entrada</MudTh>
                                <MudTh>SL / TP</MudTh>
                                <MudTh>Saída</MudTh>
                                <MudTh Style="text-align:right">Resultado</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.subtitle2"><SymbolLabel Symbol="@context.Symbol" Name="@context.Name" /></MudText>
                                        <MudChip T="string" Size="Size.Small" Class="ma-0" Variant="Variant.Filled" Color="@(context.Direction == TradeDirection.Buy ? Color.Success : Color.Error)">@(context.Direction == TradeDirection.Buy ? "COMPRA" : "VENDA")</MudChip>
                                        @if (context.SuggestionId is not null)
                                        {
                                            <MudTooltip Text="@($"Ligada à sugestão #{context.SuggestionId}")"><MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" /></MudTooltip>
                                        }
                                    </div>
                                    <MudText Typo="Typo.caption" Class="symbol-name">@context.Quantity.ToString("0.####", CultureInfo.InvariantCulture) un · @context.Platform</MudText>
                                </MudTd>
                                <MudTd>
                                    @context.EntryPrice.ToString("0.#####", CultureInfo.InvariantCulture)
                                    <MudText Typo="Typo.caption" Class="symbol-name">@context.EntryTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</MudText>
                                </MudTd>
                                <MudTd>@(context.StopLoss?.ToString("0.#####", CultureInfo.InvariantCulture) ?? "—") / @(context.TakeProfit?.ToString("0.#####", CultureInfo.InvariantCulture) ?? "—")</MudTd>
                                <MudTd>
                                    @if (context.Status == TradeStatus.Closed)
                                    {
                                        @context.ExitPrice?.ToString("0.#####", CultureInfo.InvariantCulture)
                                        <MudText Typo="Typo.caption" Class="symbol-name">@context.ExitTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</MudText>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="ma-0">Aberta</MudChip>
                                    }
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @if (context.NetPnl is { } pnl)
                                    {
                                        <MudText Typo="Typo.body2" Color="@(pnl >= 0 ? Color.Success : Color.Error)">@Money(pnl)</MudText>
                                        @if (context.RMultiple is { } r)
                                        {
                                            <MudText Typo="Typo.caption" Class="symbol-name">@r.ToString("+0.00;-0.00", CultureInfo.InvariantCulture) R</MudText>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Class="symbol-name">—</MudText>
                                    }
                                </MudTd>
                                <MudTd Style="text-align:right;white-space:nowrap">
                                    @if (context.Status == TradeStatus.Open)
                                    {
                                        <MudTooltip Text="Fechar trade"><MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Small" aria-label="@($"Fechar {context.Symbol}")" OnClick="@(() => CloseTradeDialogAsync(context))" /></MudTooltip>
                                    }
                                    <MudTooltip Text="Ver gráfico com entrada, stop e alvo"><MudIconButton Icon="@Icons.Material.Filled.CandlestickChart" Size="Size.Small" aria-label="@($"Gráfico {context.Symbol}")" OnClick="@(() => OpenChartAsync(context))" /></MudTooltip>
                                    <MudTooltip Text="Setup, emoção, etiquetas, notas e imagem"><MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" aria-label="@($"Detalhes {context.Symbol}")" OnClick="@(() => EditDetailsAsync(context))" /></MudTooltip>
                                    <MudTooltip Text="Apagar"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" aria-label="@($"Apagar {context.Symbol}")" OnClick="@(() => DeleteTradeAsync(context))" /></MudTooltip>
                                </MudTd>
                            </RowTemplate>
                            <ChildRowContent>
                                @if (!string.IsNullOrWhiteSpace(context.Notes) || context.Setup.Length > 0 || context.Tags.Length > 0 || context.Emotion.Length > 0 || context.HasImage)
                                {
                                    <MudTd colspan="6">
                                        <MudText Typo="Typo.caption" Class="symbol-name">
                                            @(string.Join(" · ", new[] { context.Setup, context.Emotion, context.Tags }.Where(x => x.Length > 0)))@(context.HasImage ? " · 🖼 imagem" : string.Empty)
                                            @(string.IsNullOrWhiteSpace(context.Notes) ? string.Empty : "📝 " + context.Notes)
                                        </MudText>
                                    </MudTd>
                                }
                            </ChildRowContent>
                        </MudTable>
                    </MudPaper>
                }
            </MudTabPanel>

            <MudTabPanel Text="Estatísticas">
                <JournalStatsPanel Stats="_stats" Currency="@_account.Currency" />
            </MudTabPanel>

            <MudTabPanel Text="Análise">
                <JournalInsightsPanel Insights="_insights" Currency="@_account.Currency" />
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private static readonly (TradeStatus? Value, string Label)[] _filters =
    [
        (null, "Todas"),
        (TradeStatus.Open, "Abertas"),
        (TradeStatus.Closed, "Fechadas")
    ];

    private readonly CancellationTokenSource _cts = new();
    private AccountProfile _account = new(10_000, 1, "EUR");
    private IReadOnlyList<WatchlistItem> _watchlist = [];
    private IReadOnlyDictionary<string, InstrumentQuote> _quotes = new Dictionary<string, InstrumentQuote>();
    private IReadOnlyList<SuggestionDto> _openSuggestions = [];
    private IReadOnlyList<JournalTradeDto> _trades = [];
    private JournalStats _stats = new(0, 0, 0, 0, 0, 0, null, 0, null, 0, 0, 0, [], 0, null, null, []);
    private JournalInsights _insights = new(0, [], [], [], [], [], [], [], [], 0, 0, null, null);
    private DailyRiskStatus? _risk;
    private CostModel _costs = new();
    private TradePrefill? _prefill;
    private TradeStatus? _filter;
    private string? _error;
    private bool _loading = true;
    private int _tab;

    [SupplyParameterFromQuery] public string? Symbol { get; set; }

    [SupplyParameterFromQuery] public double? Entry { get; set; }

    [SupplyParameterFromQuery(Name = "sl")] public double? StopLoss { get; set; }

    [SupplyParameterFromQuery(Name = "tp")] public double? TakeProfit { get; set; }

    [SupplyParameterFromQuery] public long? Suggestion { get; set; }

    [SupplyParameterFromQuery] public long? Trade { get; set; }

    private bool _focusScrolled;
    private long? _handledTrade;

    protected override async Task OnParametersSetAsync()
    {
        if (_loading || Trade == _handledTrade)
        {
            return;
        }

        _handledTrade = Trade;
        _focusScrolled = false;

        if (Trade is { } id)
        {
            if (_trades.All(t => t.Id != id))
            {
                await ReloadTradesAsync();
            }

            _tab = 1;
            _filter = null;
        }
    }

    private string TradeRowClass(JournalTradeDto trade, int index) => trade.Id == Trade ? "focus-row" : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Trade is not null && !_loading && !_focusScrolled && VisibleTrades.Any(t => t.Id == Trade))
        {
            _focusScrolled = true;
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Trader.Shared/js/nav.js");
            await module.InvokeVoidAsync("scrollToSelector", ".focus-row");
        }
    }

    private IReadOnlyList<JournalTradeDto> VisibleTrades => _filter is null ? _trades : _trades.Where(t => t.Status == _filter).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _account = await Api.GetAccountAsync(_cts.Token);
            _costs = (await Api.GetProfileAsync(_cts.Token)).Costs ?? new CostModel();
            _watchlist = await Api.GetWatchlistAsync(_cts.Token);
            _quotes = (await Api.GetInstrumentsAsync(_cts.Token, native: true)).ToDictionary(q => q.Symbol);
            _openSuggestions = await Api.GetSuggestionsAsync(null, true, 100, _cts.Token, native: true);
            await ReloadTradesAsync();

            if (Trade is not null)
            {
                _tab = 1;
                _filter = null;
            }

            _handledTrade = Trade;

            if (Entry is { } entry && StopLoss is { } stop)
            {
                _prefill = new TradePrefill(Symbol ?? string.Empty, stop < entry ? TradeDirection.Buy : TradeDirection.Sell, entry, stop, TakeProfit, 0, 1, Suggestion);
            }
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível carregar a carteira. Verifica se o servidor está a correr.";
        }
        finally
        {
            _loading = false;
        }

        await ConnectAsync();
    }

    private HubConnection? _hub;

    private async Task ConnectAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Api.NewsHubUrl, options => options.AccessTokenProvider = () => Session.GetAccessTokenAsync())
                .WithAutomaticReconnect()
                .Build();

            _hub.On<List<AlertDto>>("AlertsRaised", raised => InvokeAsync(async () =>
            {
                if (raised.Any(a => a.Kind is AlertKind.TradeStopLoss or AlertKind.TradeTakeProfit))
                {
                    try
                    {
                        await ReloadTradesAsync();
                    }
                    catch (HttpRequestException)
                    {
                    }

                    StateHasChanged();
                }
            }));

            await _hub.StartAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
        }
    }

    private async Task ReloadTradesAsync()
    {
        _trades = await Api.GetTradesAsync(null, _cts.Token);
        _stats = await Api.GetJournalStatsAsync(_cts.Token);
        _insights = await Api.GetJournalInsightsAsync(_cts.Token);
        _risk = await Api.GetDailyRiskAsync(_cts.Token);
    }

    private async Task OpenChartAsync(JournalTradeDto trade)
    {
        InstrumentQuote? quote = (await Api.GetInstrumentsAsync(_cts.Token)).FirstOrDefault(q => q.Symbol == trade.Symbol);

        if (quote is null)
        {
            Snackbar.Add("Este ativo já não está na watchlist.", Severity.Warning);
            return;
        }

        double factor = quote.DisplayFactor;
        List<ChartLevel> levels = [new ChartLevel("Entrada", trade.EntryPrice * factor, "#4C8DFF")];

        if (trade.StopLoss is { } stop)
        {
            levels.Add(new ChartLevel("Stop", stop * factor, "#EF4444"));
        }

        if (trade.TakeProfit is { } target)
        {
            levels.Add(new ChartLevel("Alvo", target * factor, "#22C55E"));
        }

        if (trade.ExitPrice is { } exit)
        {
            levels.Add(new ChartLevel("Saída", exit * factor, "#F59E0B"));
        }

        DialogParameters<ChartDialog> parameters = new() { { x => x.Quote, quote }, { x => x.ExtraLevels, levels } };
        await DialogService.ShowAsync<ChartDialog>(trade.Symbol, parameters, new DialogOptions { FullScreen = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task EditDetailsAsync(JournalTradeDto trade)
    {
        DialogParameters<TradeDetailsDialog> parameters = new() { { x => x.Trade, trade } };
        IDialogReference dialog = await DialogService.ShowAsync<TradeDetailsDialog>("Detalhes da trade", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadTradesAsync();
        }
    }

    private async Task SaveAccountAsync(AccountProfile profile)
    {
        string? error = await Api.SaveAccountAsync(profile);

        if (error is null)
        {
            _account = profile with { Currency = profile.Currency.Trim().ToUpperInvariant() };
            _risk = await Api.GetDailyRiskAsync(_cts.Token);
            Snackbar.Add("Predefinições guardadas.", Severity.Success);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            string csv = await Api.ExportJournalCsvAsync();
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Trader.Shared/js/files.js");
            await module.InvokeVoidAsync("downloadText", $"diario-trader-{DateTime.Now:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8");
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Não foi possível exportar. Verifica se o servidor está a correr.", Severity.Error);
        }
    }

    private async Task ImportCsvAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<ImportTradesDialog>("Importar trades", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false, Data: int imported } && imported > 0)
        {
            await ReloadTradesAsync();
            _tab = 1;
            Snackbar.Add($"{imported} trades importadas.", Severity.Success);
        }
    }

    private async Task OpenTradeDialogAsync(TradePrefill? prefill)
    {
        DialogParameters<TradeDialog> parameters = new()
        {
            { x => x.Prefill, prefill },
            { x => x.Symbols, _watchlist.Select(w => w.Symbol).ToList() }
        };

        IDialogReference dialog = await DialogService.ShowAsync<TradeDialog>("Registar trade", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        if (!(await dialog.Result)?.Canceled ?? false)
        {
            await ReloadTradesAsync();
            _tab = 1;
            Snackbar.Add("Trade registada.", Severity.Success);
        }
    }

    private async Task CloseTradeDialogAsync(JournalTradeDto trade)
    {
        DialogParameters<CloseTradeDialog> parameters = new() { { x => x.Trade, trade }, { x => x.Currency, _account.Currency } };

        IDialogReference dialog = await DialogService.ShowAsync<CloseTradeDialog>("Fechar trade", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        if (!(await dialog.Result)?.Canceled ?? false)
        {
            await ReloadTradesAsync();
            Snackbar.Add("Trade fechada.", Severity.Success);
        }
    }

    private async Task DeleteTradeAsync(JournalTradeDto trade)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Apagar trade",
            $"Apagar a trade de {trade.Symbol}? Esta ação não pode ser desfeita.",
            yesText: "Apagar",
            cancelText: "Cancelar");

        if (confirmed == true && await Api.DeleteTradeAsync(trade.Id))
        {
            await ReloadTradesAsync();
            Snackbar.Add("Trade apagada.", Severity.Info);
        }
    }

    private string Money(double value) => $"{value.ToString("+#,0.00;-#,0.00;0.00", CultureInfo.GetCultureInfo("pt-PT"))} {_account.Currency}";

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _ = _hub?.DisposeAsync().AsTask();
    }
}
